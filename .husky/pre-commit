# TypeScript Smoke Test (NO compilation output, just validation)
# Ensures type safety before commit to catch errors early
# Uses tsconfig.build.json to exclude test files (which have known TS issues)
pnpm --filter @bluelight-hub/backend exec tsc --noEmit --project tsconfig.build.json || exit 1

# DI Import Pattern Check (AC1)
# Story 5-7 (AC1): Ensures Injectable Classes use "import" not "import type"
# "import type" is removed at compile-time, breaking NestJS Dependency Injection
echo "🔍 Checking DI Import Patterns (AC1 Rule)..."
pnpm --filter @bluelight-hub/backend check:di:imports || {
  echo ""
  echo "❌ COMMIT BLOCKED: DI Import Pattern Violations found!"
  echo ""
  exit 1
}

# Architecture: Circular dependency check (Domain + Application layers)
# Story 5-7 (AC4): Prevents architectural violations from entering the codebase
# Checks only core business layers (Domain/Application) - Infrastructure/Presentation excluded due to legacy issues
echo "🔍 Checking circular dependencies in Domain and Application layers..."
pnpm --filter @bluelight-hub/backend lint:deps:core || {
  echo ""
  echo "❌ COMMIT BLOCKED: Circular dependencies detected in Domain or Application layer!"
  echo ""
  echo "Circular dependencies violate the Hexagonal Architecture principles."
  echo "They create tight coupling and make the codebase harder to maintain and test."
  echo ""
  echo "How to fix:"
  echo "  1. Review the circular dependency path shown above"
  echo "  2. Refactor to break the cycle (common solutions):"
  echo "     - Extract shared logic to a new module"
  echo "     - Use dependency inversion (interfaces/abstractions)"
  echo "     - Move dependencies to a common parent layer"
  echo "     - Review Domain/Application layer boundaries"
  echo ""
  echo "For details, see: docs/architecture/09-architectural-decisions.md (ADR-003)"
  echo ""
  exit 1
}

# Code quality checks (Biome linting + formatting)
pnpm lint-staged