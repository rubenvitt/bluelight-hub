{
  "name": "bluelight-hub",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --filter '@bluelight-hub/*' dev",
    "build": "pnpm -r --filter '@bluelight-hub/*' build",
    "generate-api": "pnpm -r --filter '@bluelight-hub/*' --if-present generate-api",
    "lint": "biome check --write",
    "lint:check": "biome check && pnpm -r --filter '@bluelight-hub/*' lint:check",
    "test": "pnpm -r --filter '@bluelight-hub/*' test",
    "test:ui": "pnpm -r --filter '@bluelight-hub/*' test:ui",
    "test:cov": "pnpm -r --filter '@bluelight-hub/*' test:cov",
    "prepare": "command -v husky >/dev/null 2>&1 && husky || echo 'husky not available, skipping git hooks setup'"
  },
  "packageManager": "pnpm@10.20.0+sha512.cf9998222162dd85864d0a8102e7892e7ba4ceadebbf5a31f9c2fce48dfce317a9c53b9f6464d1ef9042cba2e02ae02a9f7c143a2b438cd93c91840f0192b9dd",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@compodoc/compodoc",
      "@nestjs/core",
      "@openapitools/openapi-generator-cli",
      "@prisma/client",
      "@prisma/engines",
      "@scarf/scarf",
      "@swc/core",
      "@tailwindcss/oxide",
      "bcrypt",
      "es5-ext",
      "esbuild",
      "prisma",
      "puppeteer",
      "unrs-resolver"
    ],
    "overrides": {
      "mermaid": ">=11.10.0",
      "glob": ">=11.1.0"
    }
  },
  "lint-staged": {
    "**/*.{js,ts,tsx,json,md,yml,yaml}": ["biome check --write --no-errors-on-unmatched"],
    "packages/backend/**/*.ts": ["pnpm --filter @bluelight-hub/backend lint"],
    "packages/backend/src/domain/**/*.ts": ["pnpm --filter @bluelight-hub/backend lint:domain"],
    "packages/frontend/**/*.{ts,tsx}": ["pnpm --filter @bluelight-hub/frontend lint"]
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.4",
    "@mermaid-js/mermaid-cli": "^11.12.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.2",
    "@softwaretechnik/dbml-renderer": "^1.0.31",
    "debug": "^4.4.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "puppeteer": "^24.29.1",
    "semantic-release": "^25.0.2",
    "semantic-release-gitmoji": "^1.6.8"
  }
}
