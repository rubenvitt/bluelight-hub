# ==========================================
# BlueLight Hub Backend Environment Variables
# ==========================================
# Copy this file to .env and fill in your values

# ==== Basic Configuration ====
NODE_ENV=development
BACKEND_PORT=3091
PORT=3091

# ==== Security Configuration ====
# ⚠️ DANGER: INSECURE_MODE disables ALL Server Access Token validation!
# ⚠️ This is a DEVELOPMENT-ONLY feature for local testing without token setup.
# ⚠️ NEVER enable in production - this completely bypasses authentication!
# ⚠️ Default: false (Secure-by-Default)
# ⚠️ PRODUCTION CRASH: App will REFUSE TO START if enabled in production!
INSECURE_MODE=false

# HTTPS Configuration (Development)
# Enable HTTPS for local development (requires mkcert generated certificates)
HTTPS_ENABLED=true
# Path to certificate key file (relative to packages/backend directory or absolute)
HTTPS_KEY_PATH=../../certs/localhost-key.pem
# Path to certificate file (relative to packages/backend directory or absolute)
HTTPS_CERT_PATH=../../certs/localhost.pem

# Base URL for API (used in invite links, OAuth callbacks)
APP_URL=https://localhost:3091

# Frontend URL (used in OAuth redirect, web invite links)
FRONTEND_URL=https://localhost:3090

# ==== Database Configuration ====
# PostgreSQL Port: 3092 (Docker host mapping)
# Prisma Studio Port: 3093
DATABASE_URL="postgresql://user:password@localhost:5432/bluelight_hub?schema=public"

# CORS Configuration
ALLOWED_ORIGIN_PATTERNS=^https:\/\/[\w-]+\.bluelight-hub-app\.pages\.dev$
# ALLOWED_ORIGINS: Comma-separated list of explicit origins
# Example: https://app.example.com,https://staging.example.com
ALLOWED_ORIGINS=https://localhost:3090,https://localhost:3091

# ALLOWED_ORIGIN_PATTERNS: Comma-separated list of regex patterns
# Example: ^https://[\w-]+\.bluelight-hub-app\.pages\.dev$,^https://[\w-]+\.vercel\.app$
# Note: Use this for dynamic preview URLs like Cloudflare Pages
ALLOWED_ORIGIN_PATTERNS=

# DEVELOPMENT ONLY: Allow all origins (Wildcard)
# ALLOWED_ORIGINS=*

# ==== Error Handling Feature Flags ====
ERROR_HANDLING_ENABLE_ADVANCED_RETRY=true
ERROR_HANDLING_ENABLE_DUPLICATE_DETECTION=true
ERROR_HANDLING_ENABLE_METRICS=true
ERROR_HANDLING_ENABLE_CIRCUIT_BREAKER=true
ERROR_HANDLING_ENABLE_RATE_LIMITING=true

# ==== Logging Configuration ====
LOG_LEVEL=info

# ==== Cache Configuration ====
# TTL in Sekunden (3600 = 1 Stunde default)
CACHE_TTL_SECONDS=3600
# Maximale Anzahl von Cache-Einträgen
CACHE_MAX_ITEMS=1000

# ==== Rate Limiter Configuration ====
# Default rate limit window in milliseconds (60000 = 1 minute)
RATE_LIMITER_WINDOW_MS=60000
# Default maximum requests per window
RATE_LIMITER_MAX_REQUESTS=100

# ==== Geocoding Configuration (Lagekarte Feature) ====
# Nominatim API Endpoint for geocoding addresses to coordinates
# Default: OpenStreetMap Nominatim (free, rate-limited to 1 req/s)
# Alternative: Self-hosted Nominatim instance for production
NOMINATIM_API_URL=https://nominatim.openstreetmap.org
# Rate limit enforced by GeocodingService (1 request/second per Nominatim policy)
NOMINATIM_RATE_LIMIT=1

# ==== File Uploads Configuration ====
# Path to uploads directory (relative to packages/backend/dist/src or absolute)
# Local dev: ../../uploads (resolves to monorepo-root/uploads)
# Docker: /app/uploads (with volume mapping: ./uploads:/app/uploads in docker-compose.yml)
UPLOADS_PATH=../../uploads

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-jwt-key-change-this-in-production
ADMIN_JWT_SECRET=your-super-secret-admin-jwt-key-change-this-in-production
ADMIN_JWT_EXPIRATION=15m

# ==== Integration Encryption (Story 7-1) ====
# AES-256-GCM Encryption Key für externe API-Tokens (64 hex chars = 32 bytes)
# Generiere mit: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_ENCRYPTION_KEY=your-64-hex-chars-encryption-key-generate-with-crypto-randomBytes

# ==== HiOrg-Server OAuth2 Integration ====
# OAuth2 Credentials für HiOrg-Server API
HIORG_OAUTH_CLIENT_ID=your-hiorg-oauth-client-id
HIORG_OAUTH_CLIENT_SECRET=your-hiorg-oauth-client-secret
