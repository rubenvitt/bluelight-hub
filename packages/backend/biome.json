{
  "extends": "//",
  "formatter": {
    "enabled": true,
    "includes": ["!coverage/**", "!coverage-e2e/**", "!dist/**", "!node_modules/**"]
  },
  "linter": {
    "enabled": true,
    "rules": {},
    "includes": ["!coverage/**", "!coverage-e2e/**", "!dist/**", "!node_modules/**"]
  },
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "overrides": [
    {
      "includes": [
        "src/**/*.service.ts",
        "src/**/*.controller.ts",
        "src/**/*.indicator.ts",
        "src/**/*.strategy.ts",
        "src/**/*.repository.ts",
        "src/**/*.module.ts",
        "src/**/*.resolver.ts",
        "src/**/*.interceptor.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useImportType": "off"
          }
        }
      }
    },
    {
      "includes": ["src/domain/**/*.ts"],
      "linter": {
        "rules": {
          "nursery": {
            "noShadow": "off"
          },
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/application/*", "../application/*"],
                    "message": "❌ Domain layer MUST NOT import from Application layer (violates Hexagonal Architecture)"
                  },
                  {
                    "group": ["**/infrastructure/*", "../infrastructure/*"],
                    "message": "❌ Domain layer MUST NOT import from Infrastructure layer (violates Hexagonal Architecture)"
                  },
                  {
                    "group": ["@nestjs/*"],
                    "message": "❌ Domain layer MUST be framework-agnostic (no NestJS imports allowed)"
                  },
                  {
                    "group": ["@prisma/*"],
                    "message": "❌ Domain layer MUST NOT depend on Prisma (use Repository interfaces instead)"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
