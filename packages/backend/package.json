{
  "name": "@bluelight-hub/backend",
  "version": "1.0.0-alpha.34",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "docs:build": "compodoc -c .compodocrc.json -d docs",
    "docs:serve": "compodoc -c .compodocrc.json -d docs --serve",
    "docs:cov": "pnpm compodoc --coverageTest 85 -t -c .compodocrc.json",
    "build": "prisma generate && nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "biome check --write",
    "lint:check": "biome check",
    "lint:domain": "biome lint src/domain",
    "prisma:studio": "prisma studio -p 3093",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:domain": "jest --testPathPatterns=domain",
    "check:jsdoc": "ts-node -r tsconfig-paths/register scripts/find-missing-jsdoc.ts",
    "check:jsdoc:public": "ts-node -r tsconfig-paths/register scripts/find-missing-jsdoc.ts --public-only",
    "check:jsdoc:json": "ts-node -r tsconfig-paths/register scripts/find-missing-jsdoc.ts --json-report",
    "check:deps": "madge --circular src/domain/",
    "lint:deps": "madge --circular --extensions ts src/",
    "lint:deps:core": "madge --circular --extensions ts src/domain/ src/application/",
    "lint:arch": "biome check src/domain src/application",
    "check:arch": "pnpm lint:deps:core && pnpm lint:arch",
    "admin:reset": "ts-node -r tsconfig-paths/register src/main-cli.ts",
    "cli:archive": "ts-node -r tsconfig-paths/register src/main-cli-archive.ts",
    "test:perf": "artillery run artillery/artillery-performance.yml --output artillery/results/results.json",
    "test:perf:quick": "artillery run artillery/artillery-quick.yml --output artillery/results/quick-results.json",
    "test:perf:ci": "artillery run artillery/artillery-performance.yml --output artillery/results/ci-results.json --quiet",
    "seed:perf": "ts-node artillery/seed-performance-data.ts",
    "perf:report": "artillery report artillery/results/results.json -o artillery/results/report.html"
  },
  "dependencies": {
    "@bluelight-hub/shared": "workspace:*",
    "@dotenvx/dotenvx": "^1.51.1",
    "@dotenvx/dotenvx-ops": "^0.21.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^11.1.8",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.8",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.8",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/serve-static": "^5.0.4",
    "@nestjs/swagger": "^11.2.1",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@paralleldrive/cuid2": "^3.0.4",
    "@prisma/client": "^6.19.0",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "cache-manager": "^7.2.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.1.0",
    "helmet": "^8.1.0",
    "mgrs": "^2.1.0",
    "multer": "^2.0.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@compodoc/compodoc": "^1.1.32",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.9",
    "@swc/jest": "^0.2.39",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.3",
    "@types/ua-parser-js": "^0.7.39",
    "artillery": "^2.0.27",
    "globals": "^16.5.0",
    "jest": "^30.2.0",
    "jsonwebtoken": "^9.0.2",
    "madge": "^8.0.0",
    "prisma": "^6.19.0",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
