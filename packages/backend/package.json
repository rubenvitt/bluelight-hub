{
  "name": "@bluelight-hub/backend",
  "version": "1.0.0-alpha.104",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "docs:build": "compodoc -c .compodocrc.json -d docs",
    "docs:serve": "compodoc -c .compodocrc.json -d docs --serve",
    "docs:cov": "pnpm compodoc --coverageTest 85 -t -c .compodocrc.json",
    "build": "prisma generate && nest build -p tsconfig.build.json",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "oxlint --fix && oxfmt --write .",
    "lint:check": "oxlint && oxfmt --check .",
    "lint:domain": "oxlint src/domain",
    "prisma:studio": "prisma studio -p 3093",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:unit": "jest --coverage --testPathIgnorePatterns='\\.integration\\.spec\\.ts$' --testPathIgnorePatterns='\\.e2e\\.spec\\.ts$' --testPathIgnorePatterns='\\.smoke\\.spec\\.ts$'",
    "test:db": "jest --runInBand --testPathPatterns='\\.integration\\.spec\\.ts$|\\.e2e\\.spec\\.ts$|\\.smoke\\.spec\\.ts$'",
    "test:db:cov": "jest --runInBand --coverage --testPathPatterns='\\.integration\\.spec\\.ts$|\\.e2e\\.spec\\.ts$|\\.smoke\\.spec\\.ts$'",
    "test:domain": "jest --testPathPatterns=domain",
    "test:integration": "jest --testPathPatterns='\\.integration\\.spec\\.ts$'",
    "check:jsdoc": "tsx scripts/find-missing-jsdoc.ts",
    "check:jsdoc:public": "tsx scripts/find-missing-jsdoc.ts --public-only",
    "check:jsdoc:json": "tsx scripts/find-missing-jsdoc.ts --json-report",
    "check:di:imports": "tsx scripts/check-di-imports-zero-deps.ts",
    "check:deps": "madge --circular src/domain/",
    "lint:deps": "madge --circular --extensions ts src/",
    "lint:deps:core": "madge --circular --extensions ts src/domain/ src/application/",
    "lint:arch": "oxlint src/domain src/application && oxfmt --check src/domain src/application",
    "check:arch": "pnpm lint:deps:core && pnpm lint:arch",
    "admin:reset": "ts-node -r tsconfig-paths/register src/main-cli.ts",
    "cli:archive": "ts-node -r tsconfig-paths/register src/main-cli-archive.ts",
    "cli:invite-once": "ts-node -r tsconfig-paths/register src/main-cli-invite-once.ts",
    "test:perf": "artillery run artillery/artillery-performance.yml --output artillery/results/results.json",
    "test:perf:quick": "artillery run artillery/artillery-quick.yml --output artillery/results/quick-results.json",
    "test:perf:ci": "artillery run artillery/artillery-performance.yml --output artillery/results/ci-results.json --quiet",
    "seed:perf": "tsx artillery/seed-performance-data.ts",
    "perf:report": "artillery report artillery/results/results.json -o artillery/results/report.html",
    "update-api-snapshot": "jest --testPathPatterns=api-contract --no-coverage --updateSnapshot"
  },
  "dependencies": {
    "@bluelight-hub/shared": "workspace:*",
    "@dotenvx/dotenvx": "^1.61.1",
    "@dotenvx/dotenvx-ops": "^0.37.9",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/cache-manager": "^3.1.2",
    "@nestjs/common": "^11.1.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/platform-socket.io": "^11.1.19",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "^11.3.2",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.19",
    "@paralleldrive/cuid2": "^3.3.0",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@willsoto/nestjs-prometheus": "^6.1.0",
    "axios": "^1.15.1",
    "bcrypt": "^6.0.0",
    "cache-manager": "^7.2.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.1.0",
    "helmet": "^8.1.0",
    "mgrs": "^2.1.0",
    "multer": "^2.1.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.18.0",
    "pg": "^8.20.0",
    "prom-client": "^15.1.3",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@compodoc/compodoc": "^1.2.1",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/testing": "^11.1.19",
    "@swc/jest": "^0.2.39",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.6.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.0",
    "@types/ua-parser-js": "^0.7.39",
    "@types/web-push": "^3.6.4",
    "artillery": "^2.0.31",
    "globals": "^17.6.0",
    "jest": "^30.3.0",
    "jsonwebtoken": "^9.0.3",
    "madge": "^8.0.0",
    "prisma": "^7.7.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
