// ========================================
// Notizen (Story 7.1)
// Epic 7: Notizen im Einsatz-Kontext
// ========================================

model Notiz {
  id          String  @id @default(cuid())
  einsatzId   String  @map("einsatz_id")
  titel       String  @db.VarChar(100)
  inhalt      String? @db.Text
  kategorie   String? @db.VarChar(50) // LEGACY: Altes Freitext-Feld (wird nicht mehr im UI genutzt)
  // Story 8.2: Kategorie-Referenz (ersetzt das alte Freitext-Feld)
  kategorieId String? @map("kategorie_id")

  // Audit Trail
  erstelltVon String   @map("erstellt_von") @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Team-Sichtbarkeit (Story 7.7)
  istTeamsichtbar Boolean @default(false) @map("ist_teamsichtbar")

  // Soft-Delete (NO-DELETE Policy)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.VarChar(100)

  // Relations
  einsatz      Einsatz      @relation(fields: [einsatzId], references: [id], onDelete: Cascade)
  ersteller    User         @relation("NotizCreator", fields: [erstelltVon], references: [id], onDelete: Restrict)
  loescher     User?        @relation("NotizDeleter", fields: [deletedBy], references: [id], onDelete: Restrict)
  erinnerungen Erinnerung[] // Story 7.6: Rück-Relation für Notiz → Erinnerung Konvertierung
  kategorieRef Kategorie?   @relation("NotizKategorie", fields: [kategorieId], references: [id], onDelete: SetNull) // Story 8.2

  @@index([einsatzId, isDeleted, createdAt])
  @@index([einsatzId, isDeleted, istTeamsichtbar, createdAt])
  @@index([einsatzId, createdAt])
  @@index([erstelltVon])
  @@index([kategorieId]) // Story 8.2: Filter nach Kategorie
  @@map("notizen")
}

// ========================================
// Befehl-Management (Story 1.1 Befehle)
// Epic 1: Führung & Befehle – Befehlsmanagement im Einsatz
// ========================================

/// Befehl Status Enum
/// Definiert den Lebenszyklus eines Befehls gemäß State Machine:
/// ERTEILT → ZUGESTELLT → QUITTIERT
/// ERTEILT → KORRIGIERT (Befehl durch Korrekturbefehl ersetzt)
enum BefehlStatus {
  ERTEILT // Initialer Status bei Befehlserstellung
  ZUGESTELLT // Alle Empfänger haben den Befehl erhalten
  QUITTIERT // Alle Empfänger haben quittiert
  KORRIGIERT // Befehl wurde durch Korrekturbefehl ersetzt
}

/// Quittierung Art Enum
/// Art der Quittierung durch einen Befehlsempfänger
enum QuittierungArt {
  VERSTANDEN // Befehl verstanden und wird ausgeführt
  RUECKFRAGE // Rückfrage zum Befehl
  NICHT_VERSTANDEN // Befehl nicht verstanden
}

/// Befehl: Führungsbefehl im Einsatz-Kontext
/// - Append-Only: Befehle werden NIEMALS gelöscht (GoBD-Compliance)
/// - Korrektur über originalBefehlId (neuer Befehl verweist auf den korrigierten)
/// - Befehlstyp (KURZBEFEHL/EAMZW/ERWEITERT) ist computed, NICHT in DB
/// - Cascade-Delete mit Einsatz (Einsatzdaten transient)
model Befehl {
  id               String       @id @default(cuid())
  nummer           String       @db.VarChar(255) // Format: B-{SEQ} (z.B. B-001)
  einsatzId        String       @map("einsatz_id")
  auftrag          String       @db.Text // Pflichtfeld: Kern-Auftrag
  befehlsgeberName String       @map("befehlsgeber_name") @db.VarChar(255)
  befehlsgeberId   String?      @map("befehlsgeber_id") @db.VarChar(100)
  erstellerId      String?      @map("ersteller_id") @db.VarChar(100)
  status           BefehlStatus @default(ERTEILT)

  // Optionale EAMZW-Felder (Ereignis, Auftrag, Mittel, Ziel, Weg)
  zeitvorgabe String? @db.Text
  ereignis    String? @db.Text
  mittel      String? @db.Text
  ziel        String? @db.Text
  weg         String? @db.Text

  // Korrekturbefehl-Verkettung (Append-Only)
  originalBefehlId String? @map("original_befehl_id")

  // Timestamps
  erteiltAm DateTime @default(now()) @map("erteilt_am")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // DSGVO Soft-Delete & Anonymisierung (Story 5.5)
  isDeleted      Boolean   @default(false) @map("is_deleted")
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?   @map("deleted_by") @db.VarChar(100)
  anonymisiertAm DateTime? @map("anonymisiert_am")

  // Relations
  einsatz        Einsatz            @relation(fields: [einsatzId], references: [id], onDelete: Cascade)
  befehlsgeber   User?              @relation("BefehlBefehlsgeber", fields: [befehlsgeberId], references: [id], onDelete: Restrict)
  ersteller      User?              @relation("BefehlErsteller", fields: [erstellerId], references: [id], onDelete: SetNull)
  originalBefehl Befehl?            @relation("BefehlKorrektur", fields: [originalBefehlId], references: [id], onDelete: SetNull)
  korrekturen    Befehl[]           @relation("BefehlKorrektur")
  empfaenger     BefehlEmpfaenger[]
  kommentare     BefehlKommentar[]

  // Indexes
  @@unique([einsatzId, nummer])
  @@index([einsatzId])
  @@index([status])
  @@index([originalBefehlId])
  @@index([einsatzId, status])
  @@index([einsatzId, createdAt])
  @@index([isDeleted], map: "idx_befehl_is_deleted")
  @@index([anonymisiertAm], map: "idx_befehl_anonymisiert_am")
  @@map("befehl")
}

/// BefehlEmpfaenger: Empfänger eines Befehls mit individuellem Zustellungs- und Quittierungsstatus
/// - Wird über Befehl Aggregate persistiert (kein eigenes Repository)
/// - Zustellungs- und Quittierungszeitpunkte pro Empfänger individuell
/// - Cascade-Delete mit Befehl
model BefehlEmpfaenger {
  id                   String          @id @default(cuid())
  befehlId             String          @map("befehl_id")
  name                 String          @db.VarChar(255)
  empfaengerId         String?         @map("empfaenger_id") @db.VarChar(100)
  zugestelltAm         DateTime?       @map("zugestellt_am")
  quittiertAm          DateTime?       @map("quittiert_am")
  quittierungArt       QuittierungArt? @map("quittierung_art")
  quittierungKommentar String?         @map("quittierung_kommentar") @db.Text

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")

  // DSGVO Soft-Delete (Story 5.5)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.VarChar(100)

  // Relations
  befehl     Befehl @relation(fields: [befehlId], references: [id], onDelete: Cascade)
  empfaenger User?  @relation("BefehlEmpfaengerUser", fields: [empfaengerId], references: [id], onDelete: Restrict)

  // Constraints: Ein Name kann pro Befehl nur einmal Empfänger sein
  @@unique([befehlId, name])
  // Indexes
  @@index([befehlId])
  @@index([empfaengerId])
  @@index([isDeleted], map: "idx_befehl_empfaenger_is_deleted")
  @@map("befehl_empfaenger")
}

/// BefehlKommentar: Kommentar/Rückfrage zu einem Befehl mit Thread-Support
/// - Thread-Support via parentId (Self-Relation)
/// - isRueckfrage markiert Kommentare die aus einer Quittierungs-Rückfrage entstanden
/// - Cascade-Delete mit Befehl
model BefehlKommentar {
  id           String  @id @default(cuid())
  befehlId     String  @map("befehl_id")
  authorId     String? @map("author_id") @db.VarChar(100)
  text         String  @db.Text
  isRueckfrage Boolean @default(false) @map("is_rueckfrage")
  parentId     String? @map("parent_id") // Thread-Support: Verweis auf übergeordneten Kommentar

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")

  // DSGVO Soft-Delete (Story 5.5)
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.VarChar(100)

  // Relations
  befehl   Befehl            @relation(fields: [befehlId], references: [id], onDelete: Cascade)
  author   User?             @relation("BefehlKommentarAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  parent   BefehlKommentar?  @relation("KommentarThread", fields: [parentId], references: [id], onDelete: SetNull)
  children BefehlKommentar[] @relation("KommentarThread")

  // Indexes
  @@index([befehlId])
  @@index([authorId])
  @@index([parentId])
  @@index([isDeleted], map: "idx_befehl_kommentar_is_deleted")
  @@map("befehl_kommentar")
}

// ========================================
// Einsatz-Rollenzuweisung (Story 5.2)
// ========================================

enum EinsatzRolle {
  BEFEHLSGEBER
  ERSTELLER
  EMPFAENGER
  BEOBACHTER
}

model EinsatzRollenzuweisung {
  id           String       @id @default(cuid())
  einsatzId    String       @map("einsatz_id")
  userId       String       @map("user_id")
  rolle        EinsatzRolle
  zugewiesenAm DateTime     @default(now()) @map("zugewiesen_am")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  // Relations
  einsatz Einsatz @relation(fields: [einsatzId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([einsatzId, userId])
  @@index([einsatzId])
  @@map("einsatz_rollenzuweisung")
}

// ========================================
// DSGVO Aufbewahrung (Story 5.5)
// ========================================

/// AufbewahrungsKonfiguration: Singleton-Config für DSGVO-Aufbewahrungsregeln
/// - Immer nur EIN aktiver Datensatz (Singleton-Pattern via upsert)
/// - Default: 10 Jahre Aufbewahrungsfrist (GoBD §147 AO), 30 Tage Freigabeperiode
/// - Jede Änderung erzeugt einen ETB-Audit-Eintrag
model AufbewahrungsKonfiguration {
  id                       String   @id @default(cuid())
  isSingleton              Boolean  @default(true) @unique @map("is_singleton")
  aufbewahrungsfristJahre  Int      @default(10) @map("aufbewahrungsfrist_jahre")
  freigabeperiodeTage      Int      @default(30) @map("freigabeperiode_tage")
  automatischLoeschenAktiv Boolean  @default(false) @map("automatisch_loeschen_aktiv")
  updatedBy                String?  @map("updated_by") @db.VarChar(100)
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  // Relations
  updater User? @relation("AufbewahrungsKonfigurationUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("aufbewahrungs_konfiguration")
}

/// ComplianceReport: Dokumentation der DSGVO-Anonymisierungsläufe
/// - Wird automatisch pro anonymisiertem Einsatz erstellt
/// - Audit-Trail für Datenschutzbeauftragten
/// - Enthält Metadaten über anonymisierte Daten (Anzahl, Zeitpunkt, Frist)
model ComplianceReport {
  id                 String    @id @default(cuid())
  einsatzId          String    @map("einsatz_id")
  einsatzName        String?   @map("einsatz_name") @db.VarChar(255)
  beendetAm          DateTime? @map("beendet_am")
  befehlCount        Int       @default(0) @map("befehl_count")
  empfaengerCount    Int       @default(0) @map("empfaenger_count")
  kommentarCount     Int       @default(0) @map("kommentar_count")
  aufbewahrungsfrist Int       @map("aufbewahrungsfrist") // In Jahren, zum Zeitpunkt der Anonymisierung
  anonymisiertAm     DateTime  @map("anonymisiert_am")
  reportData         Json?     @map("report_data") @db.JsonB // Erweiterte Report-Details
  createdAt          DateTime  @default(now()) @map("created_at")

  // Relations
  einsatz Einsatz @relation(fields: [einsatzId], references: [id], onDelete: Restrict)

  @@index([einsatzId], map: "idx_compliance_report_einsatz")
  @@index([anonymisiertAm], map: "idx_compliance_report_anonymisiert")
  @@map("compliance_report")
}

/// BefehlsgeberVorschlag: Konfigurierbare Vorschläge für das Befehlsgeber-Feld
/// - Admin-CRUD über Admin-Panel
/// - Werden im Dropdown gruppiert mit EinsatzPersonen angezeigt
/// - Soft-Deactivation statt Hard-Delete
model BefehlsgeberVorschlag {
  id        String  @id @default(cuid())
  kuerzel   String  @unique @db.VarChar(20)
  label     String  @db.VarChar(100)
  istAktiv  Boolean @default(true) @map("ist_aktiv")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String   @map("created_by") @db.VarChar(100)
  updatedBy String?  @map("updated_by") @db.VarChar(100)

  creator User  @relation("BefehlsgeberVorschlagCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater User? @relation("BefehlsgeberVorschlagUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([istAktiv, sortOrder])
  @@map("befehlsgeber_vorschlaege")
}

/// Beitrittsanfrage: Einsatzkraft fragt Beitritt zu einem Einsatz an
/// Führungskraft genehmigt oder lehnt ab (Issue #98)
model EinsatzBeitrittsanfrage {
  id         String                  @id @default(cuid())
  einsatzId  String
  userId     String
  status     BeitrittsanfrageStatus  @default(OFFEN)
  createdAt  DateTime                @default(now())
  resolvedAt DateTime?
  resolvedBy String?                 @db.VarChar(100)

  // Relations
  einsatz  Einsatz @relation(fields: [einsatzId], references: [id], onDelete: Cascade)
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  resolver User?   @relation("BeitrittsanfrageResolver", fields: [resolvedBy], references: [id], onDelete: SetNull)

  @@unique([einsatzId, userId])
  @@index([einsatzId, status])
  @@index([userId, status])
  @@map("einsatz_beitrittsanfragen")
}

// ========================================
// Gefahrenmatrix Models (Issue #414)
// ========================================

enum Gefahrentyp {
  ATEMGIFTE
  ANGSTREAKTION
  AUSBREITUNG
  ATOMARE_STRAHLUNG
  CHEMISCHE_STOFFE
  ERKRANKUNG_VERLETZUNG
  EXPLOSION
  ELEKTRIZITAET
  EINSTURZ
  ABSTURZ
  BRAND
  DURCHBRUCH
  ERTRINKEN
}

enum Schutzobjekt {
  MENSCHEN
  TIERE
  UMWELT
  SACHWERTE
  EINSATZKRAEFTE
}

enum Warnstufe {
  KEINE
  NIEDRIG
  MITTEL
  HOCH
  AKUT
}

model GefahrenmatrixBewertung {
  id            String       @id @default(cuid())
  einsatzId     String
  gefahrentyp   Gefahrentyp
  schutzobjekt  Schutzobjekt
  warnstufe     Warnstufe    @default(KEINE)
  beschreibung  String?      @db.Text
  gemeldetVon   String?      @db.VarChar(255)
  aktualisiertVon String     @db.VarChar(100)

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Relations
  einsatz       Einsatz      @relation(fields: [einsatzId], references: [id], onDelete: Restrict)
  gefahrenzonen Gefahrenzone[]

  // Constraints: Pro Einsatz nur eine Bewertung pro Gefahrentyp+Schutzobjekt
  @@unique([einsatzId, gefahrentyp, schutzobjekt])
  @@index([einsatzId])
  @@map("gefahrenmatrix_bewertungen")
}

/// Geometrietyp einer Gefahrenzone. CIRCLE-Zonen werden als 64-Punkt-Polygon gespeichert.
enum GefahrenzoneGeometryType {
  POLYGON
  CIRCLE
}

/// Gefahrenzone: räumliche Verortung einer Matrix-Zelle auf der Lagekarte (Issue #627).
///
/// Composite FK auf (einsatzId, gefahrentyp, schutzobjekt) referenziert die Matrix-Zelle
/// (ADR-010). Beim Create wird die Zelle implizit mit warnstufe=KEINE angelegt, wenn sie
/// noch nicht existiert. Warnstufe lebt ausschließlich in der Matrix — keine Duplikation.
model Gefahrenzone {
  id              String       @id @default(cuid())
  einsatzId       String
  gefahrentyp     Gefahrentyp
  schutzobjekt    Schutzobjekt
  geometryType    GefahrenzoneGeometryType
  geometry        Json         @db.JsonB
  bezeichnung     String?      @db.VarChar(200)
  erstelltVon     String       @db.VarChar(100)
  aktualisiertVon String?      @db.VarChar(100)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relations
  einsatz         Einsatz                 @relation(fields: [einsatzId], references: [id], onDelete: Cascade)
  matrixZelle     GefahrenmatrixBewertung @relation(fields: [einsatzId, gefahrentyp, schutzobjekt], references: [einsatzId, gefahrentyp, schutzobjekt], onDelete: Restrict)

  // Eigenschutz Relations (Issue #415 / Story 1.4) — Gefährdungsbeurteilungen referenzieren optional eine Gefahrenzone
  gefaehrdungsbeurteilungen Gefaehrdungsbeurteilung[]

  @@index([einsatzId])
  @@index([einsatzId, gefahrentyp, schutzobjekt])
  @@map("gefahrenzonen")
}

// ========================================
// Funkverkehr Models (Issue #407)
// ========================================

/// Funkkanal: Pro Einsatz verwaltete Sprechgruppen/Kanäle (TMO/DMO/Analog).
/// - detailsType + detailsData bilden eine Discriminated Union
/// - Lifecycle: aktiv -> inaktiv (pausiert) <-> aktiv, oder archiviert (terminal)
/// - Cascade-Delete mit Einsatz
model Funkkanal {
  id          String @id @default(cuid())
  einsatzId   String @map("einsatz_id")

  name        String
  detailsType String @map("details_type") // 'tmo' | 'dmo' | 'analog'
  detailsData Json   @map("details_data") @db.JsonB
  status      String @default("aktiv") // 'aktiv' | 'inaktiv' | 'archiviert'
  zweck       String?
  sortIndex   Int    @default(0) @map("sort_index")

  // Audit Trail
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  // Relations
  einsatz     Einsatz              @relation(fields: [einsatzId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  zuordnungen FunkkanalZuordnung[]

  // Constraints
  @@unique([einsatzId, name])
  @@index([einsatzId, status, sortIndex])
  @@map("funkkanal")
}

/// FunkkanalZuordnung: Polymorphe Zuordnung einer Kraft (Fahrzeug | Person | Einheit)
/// zu einem Funkkanal. Genau eine der drei FKs ist gesetzt (Check-Constraint).
/// - rufnameSnapshot konserviert den Namen zum Zeitpunkt der Zuordnung
/// - rolle: primaer | sekundaer | zuhoeren
/// - Cascade-Delete mit Kanal und mit der zugeordneten Kraft
model FunkkanalZuordnung {
  id      String @id @default(cuid())
  kanalId String @map("kanal_id")

  fahrzeugId String? @map("fahrzeug_id")
  personId   String? @map("person_id")
  einheitId  String? @map("einheit_id")

  rufnameSnapshot String @map("rufname_snapshot")
  rolle           String @default("primaer") // 'primaer' | 'sekundaer' | 'zuhoeren'

  // Audit Trail
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  // Relations
  kanal    Funkkanal        @relation(fields: [kanalId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  fahrzeug EinsatzFahrzeug? @relation(fields: [fahrzeugId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  person   EinsatzPerson?   @relation(fields: [personId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  einheit  EinsatzEinheit?  @relation(fields: [einheitId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // Constraints: Eine Kraft kann pro Kanal nur einmal zugeordnet sein
  @@unique([kanalId, fahrzeugId])
  @@unique([kanalId, personId])
  @@unique([kanalId, einheitId])
  @@index([kanalId])
  @@index([fahrzeugId])
  @@index([personId])
  @@index([einheitId])
  @@map("funkkanal_zuordnung")
}

// ========================================
// Alarmierung Models (Issue #408)
// ========================================

/// Alarmierung: Auslösung eines Alarms für N Empfänger (Fahrzeuge, Personen, Einheiten).
/// - Nachalarmierung via ursprungAlarmierungId-Selbstreferenz
/// - Status: 'aktiv' (Empfänger noch im Einsatz-Prozess) | 'abgeschlossen' (manuell geschlossen)
/// - Cascade-Delete mit Einsatz
model Alarmierung {
  id                    String    @id @default(cuid())
  einsatzId             String    @map("einsatz_id")
  bezeichnung           String    @db.VarChar(200)
  beschreibung          String?   @db.Text
  alarmierungszeit      DateTime  @map("alarmierungszeit")
  status                String    @default("aktiv") // 'aktiv' | 'abgeschlossen'
  ursprungAlarmierungId String?   @map("ursprung_alarmierung_id")

  // Audit Trail (PFLICHT)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String   @map("created_by") @db.VarChar(100)
  updatedBy String?  @map("updated_by") @db.VarChar(100)

  // Relations
  einsatz           Einsatz                 @relation(fields: [einsatzId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  ursprung          Alarmierung?            @relation("Nachalarmierung", fields: [ursprungAlarmierungId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  nachalarmierungen Alarmierung[]           @relation("Nachalarmierung")
  empfaenger        AlarmierungEmpfaenger[]

  // Indexes
  @@index([einsatzId])
  @@index([einsatzId, status])
  @@index([einsatzId, alarmierungszeit])
  @@index([ursprungAlarmierungId])
  @@map("alarmierung")
}

/// AlarmierungEmpfaenger: Polymorpher Empfänger (Fahrzeug | Person | Einheit) einer Alarmierung.
/// - Genau eine der drei FKs ist gesetzt (Check-Constraint via Migration)
/// - nameSnapshot konserviert den Anzeigenamen zum Zeitpunkt der Alarmierung
/// - 4 nachtragbare Zeitpunkte (alarmiertAm Pflicht, Rest optional)
/// - letzterFmsStatus: Verweis auf FMS-Status zur Auto-Population (nur Fahrzeug-Empfänger)
model AlarmierungEmpfaenger {
  id            String @id @default(cuid())
  alarmierungId String @map("alarmierung_id")

  // Polymorphe FK (genau eine gesetzt)
  fahrzeugId String? @map("fahrzeug_id")
  personId   String? @map("person_id")
  einheitId  String? @map("einheit_id")

  // Snapshot (Funkrufname / Vor+Nachname / Einheiten-Name)
  nameSnapshot String @map("name_snapshot") @db.VarChar(200)

  // Zeitpunkte (alarmiertAm Pflicht, Rest nachtragbar)
  alarmiertAm     DateTime  @map("alarmiert_am")
  ausgeruecktAm   DateTime? @map("ausgerueckt_am")
  vorOrtAm        DateTime? @map("vor_ort_am")
  wiederFreiAm    DateTime? @map("wieder_frei_am")

  // FMS-Auto-Population-Tracking (nur bei Fahrzeug-Empfängern relevant)
  letzterFmsStatus Int? @map("letzter_fms_status")

  // Audit Trail
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String   @map("created_by") @db.VarChar(100)
  updatedBy String?  @map("updated_by") @db.VarChar(100)

  // Relations
  alarmierung Alarmierung      @relation(fields: [alarmierungId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  fahrzeug    EinsatzFahrzeug? @relation(fields: [fahrzeugId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  person      EinsatzPerson?   @relation(fields: [personId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  einheit     EinsatzEinheit?  @relation(fields: [einheitId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  // Constraints: Ein Empfänger-Referenzziel kann pro Alarmierung nur einmal vorkommen
  @@unique([alarmierungId, fahrzeugId])
  @@unique([alarmierungId, personId])
  @@unique([alarmierungId, einheitId])

  // Indexes
  @@index([alarmierungId])
  @@index([fahrzeugId])
  @@index([personId])
  @@index([einheitId])
  @@map("alarmierung_empfaenger")
}

// ============================================================================
// Push-Notifications (Story 1.1 Plattform, ADR-011)
// ============================================================================
//
// Web-Push Subscription einer User-Session/Geräts.
// Persistiert endpoint + VAPID-Keys, um Notifications via web-push@^3 zu senden.
// User-scoped (eine Subscription gilt über alle Einsätze hinweg) — siehe ADR-011.

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique @db.Text
  p256dh    String   @db.Text
  auth      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // Indexes
  @@index([userId], map: "idx_push_subscription_user_id")
  @@map("push_subscription")
}

// ============================================================================
// Eigenschutz-Modul (Issue #415, Story 1.4)
// ============================================================================
// Schema-Additions gemäß _bmad-output/planning-artifacts/architecture.md
// §Prisma Schema-Additions (Zeilen 1312–1616).
//
// 7 Enums + 14 Models. Kein Prisma-Enum `EigenschutzRolle`: Eigenschutz-Rollen
// werden als `RollenDefinition`-Seed-Records angelegt und über
// `EinsatzRollenbesetzung.rollenName` mit Präfix `^Eigenschutz: ` geprüft
// (Story 1.3 EinsatzScopeGuard, Story 1.5 EigenschutzRolleGuard).

enum PsaProfil {
  BASIS
  INFEKTION
  VU
  CBRN_PATIENT
  VOLLSCHUTZ
}

enum Eintrittswahrscheinlichkeit {
  SELTEN
  GELEGENTLICH
  HAEUFIG
  OFT
  STAENDIG
}

enum Schadensausmass {
  VERNACHLAESSIGBAR
  GERING
  MITTEL
  HOCH
  KATASTROPHAL
}

enum Risikoklasse {
  GRUEN
  GELB
  ORANGE
  ROT
}

enum Ampelstatus {
  GRUEN
  GELB
  ROT
}

enum SyncConflictEntityType {
  GEFAEHRDUNGSBEURTEILUNG_ITEM
  PSA_PROFIL_ZUWEISUNG
}

enum SyncConflictResolution {
  SERVER_WINS
  LOCAL_WINS
  MERGED
}

/// Gefährdungsbeurteilung — Haupt-Entität pro Einsatz+Einheit (State + Version-Chain Pattern, §B1).
/// `items` ist JSON-Array der aktuellen Gefährdungen; Historie lebt in `GefaehrdungsbeurteilungVersion`.
model Gefaehrdungsbeurteilung {
  id                    String   @id @default(cuid())
  einsatzId             String   @map("einsatz_id")
  einheitId             String   @map("einheit_id")
  gefahrenzoneId        String?  @map("gefahrenzone_id")
  vorlageId             String?  @map("vorlage_id")
  items                 Json
  version               Int      @default(1)
  erstelltAm            DateTime @default(now()) @map("erstellt_am")
  erstelltVonUserId     String   @map("erstellt_von_user_id")
  aktualisiertAm        DateTime @updatedAt @map("aktualisiert_am")
  aktualisiertVonUserId String   @map("aktualisiert_von_user_id")

  einsatz      Einsatz                         @relation(fields: [einsatzId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  gefahrenzone Gefahrenzone?                   @relation(fields: [gefahrenzoneId], references: [id], onDelete: SetNull)
  vorlage      GefaehrdungsbeurteilungVorlage? @relation(fields: [vorlageId], references: [id], onDelete: SetNull)
  versionen    GefaehrdungsbeurteilungVersion[]

  @@unique([einsatzId, einheitId])
  @@index([einsatzId])
  @@map("gefaehrdungsbeurteilungen")
}

/// Version-Chain für Gefährdungsbeurteilung — append-only. `eventId @unique` verhindert Doppel-Outbox-Processing.
model GefaehrdungsbeurteilungVersion {
  id               String    @id @default(cuid())
  gefBeurteilungId String    @map("gef_beurteilung_id")
  version          Int
  items            Json
  changedFields    Json      @map("changed_fields")
  gueltigVon       DateTime  @map("gueltig_von")
  gueltigBis       DateTime? @map("gueltig_bis")
  changedByUserId  String    @map("changed_by_user_id")
  begruendung      String?   @db.VarChar(500)
  eventId          String?   @unique @map("event_id")

  gefBeurteilung Gefaehrdungsbeurteilung @relation(fields: [gefBeurteilungId], references: [id], onDelete: Cascade)
  // HINWEIS: FK kommt vom Vorfall auf diese Version (siehe EigenschutzVorfall.gefBeurteilungVersionId)
  vorfaelle      EigenschutzVorfall[]

  @@unique([gefBeurteilungId, version])
  @@index([gefBeurteilungId, gueltigVon])
  @@map("gefaehrdungsbeurteilung_versionen")
}

/// Vorlagen-Tabelle — Seeds für Szenarien (MANV, VU, Großveranstaltung, Betreuung, CBRN). `slug @unique` für idempotente Upserts.
model GefaehrdungsbeurteilungVorlage {
  id                String   @id @default(cuid())
  slug              String   @unique @db.VarChar(100)
  name              String   @db.VarChar(200)
  szenario          String   @db.VarChar(80)
  items             Json
  version           Int      @default(1)
  aktiv             Boolean  @default(true)
  erstelltAm        DateTime @default(now()) @map("erstellt_am")
  erstelltVonUserId String?  @map("erstellt_von_user_id")

  nutzerBeurteilungen Gefaehrdungsbeurteilung[]

  @@map("gefaehrdungsbeurteilung_vorlagen")
}

/// PSA-Profil-Zuweisung pro Einsatz+Einheit. `propagationGroupId` gruppiert Multi-Select-Bulk-Änderungen (FR18, Story 3.2).
model PsaProfilZuweisung {
  id                 String    @id @default(cuid())
  einsatzId          String    @map("einsatz_id")
  einheitId          String    @map("einheit_id")
  profil             PsaProfil
  gueltigVon         DateTime  @map("gueltig_von")
  gueltigBis         DateTime? @map("gueltig_bis")
  aktiviertVonUserId String    @map("aktiviert_von_user_id")
  begruendung        String    @db.VarChar(500)
  propagationGroupId String    @map("propagation_group_id")
  version            Int       @default(1)

  einsatz Einsatz @relation(fields: [einsatzId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([einsatzId, einheitId, gueltigBis])
  @@index([propagationGroupId])
  @@map("psa_profil_zuweisungen")
}

/// Quittungs-Tabelle PSA — FR18/Story 3.4. Ein Empfänger quittiert pro `propagationGroupId` + `einheitId` höchstens einmal.
model PsaProfilQuittung {
  id                 String   @id @default(cuid())
  propagationGroupId String   @map("propagation_group_id")
  einsatzId          String   @map("einsatz_id")
  einheitId          String   @map("einheit_id")
  quittiertAm        DateTime @default(now()) @map("quittiert_am")
  quittiertVonUserId String   @map("quittiert_von_user_id")
  lueckeGemeldet     Boolean  @default(false) @map("luecke_gemeldet")
  lueckeNotiz        String?  @map("luecke_notiz") @db.VarChar(1000)

  @@unique([propagationGroupId, einheitId])
  @@index([einsatzId, einheitId])
  @@map("psa_profil_quittungen")
}

/// Sicherheitsregel — einheitId optional (null = gilt für gesamten Einsatz).
model Sicherheitsregel {
  id                    String   @id @default(cuid())
  einsatzId             String   @map("einsatz_id")
  einheitId             String?  @map("einheit_id")
  titel                 String   @db.VarChar(200)
  inhalt                String   @db.Text
  version               Int      @default(1)
  erstelltAm            DateTime @default(now()) @map("erstellt_am")
  erstelltVonUserId     String   @map("erstellt_von_user_id")
  aktualisiertAm        DateTime @updatedAt @map("aktualisiert_am")
  aktualisiertVonUserId String   @map("aktualisiert_von_user_id")

  einsatz    Einsatz                    @relation(fields: [einsatzId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  versionen  SicherheitsregelVersion[]
  quittungen SicherheitsregelQuittung[]

  @@index([einsatzId])
  @@map("sicherheitsregeln")
}

model SicherheitsregelVersion {
  id              String    @id @default(cuid())
  regelId         String    @map("regel_id")
  version         Int
  titel           String    @db.VarChar(200)
  inhalt          String    @db.Text
  gueltigVon      DateTime  @map("gueltig_von")
  gueltigBis      DateTime? @map("gueltig_bis")
  changedByUserId String    @map("changed_by_user_id")
  eventId         String?   @unique @map("event_id")

  regel Sicherheitsregel @relation(fields: [regelId], references: [id], onDelete: Cascade)

  @@unique([regelId, version])
  @@map("sicherheitsregel_versionen")
}

/// Quittungs-Tabelle Sicherheitsregel — FR25/Story 2.7. Ein Empfänger quittiert pro `regelId` + `einheitId` höchstens einmal.
model SicherheitsregelQuittung {
  id                 String   @id @default(cuid())
  regelId            String   @map("regel_id")
  einheitId          String   @map("einheit_id")
  quittiertAm        DateTime @default(now()) @map("quittiert_am")
  quittiertVonUserId String   @map("quittiert_von_user_id")

  regel Sicherheitsregel @relation(fields: [regelId], references: [id], onDelete: Cascade)

  @@unique([regelId, einheitId])
  @@map("sicherheitsregel_quittungen")
}

/// Sicherungsposten — `standort` ist Discriminated-Union-JSON ({kind:'coordinate'|address}), `personal` ist Array discriminated-Union {kind:'user'|freitext}.
/// `geloescht`-Boolean (Story 1.4) bleibt aus Backwards-Compat erhalten; der maßgebliche Auflösungs-Vertrag ist seit Story 4.1 `aufgeloestAm IS NOT NULL`.
model Sicherungsposten {
  id                     String    @id @default(cuid())
  einsatzId              String    @map("einsatz_id")
  einheitId              String?   @map("einheit_id")
  bezeichnung            String    @db.VarChar(200)
  standort               Json
  zustaendigkeitsbereich String?   @db.Text
  personal               Json
  abloesezeiten          String?   @db.VarChar(2000)
  version                Int       @default(1)
  erstelltAm             DateTime  @default(now()) @map("erstellt_am")
  erstelltVonUserId      String    @map("erstellt_von_user_id")
  aktualisiertAm         DateTime  @updatedAt @map("aktualisiert_am")
  aktualisiertVonUserId  String    @map("aktualisiert_von_user_id")
  geloescht              Boolean   @default(false)
  aufgeloestAm           DateTime? @map("aufgeloest_am")
  aufgeloestVonUserId    String?   @map("aufgeloest_von_user_id") @db.VarChar(30)
  aufloeseBegruendung    String?   @map("aufloese_begruendung") @db.VarChar(2000)

  einsatz   Einsatz                   @relation(fields: [einsatzId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  versionen SicherungspostenVersion[]

  @@index([einsatzId])
  @@index([einsatzId, aufgeloestAm])
  @@map("sicherungsposten")
}

model SicherungspostenVersion {
  id              String    @id @default(cuid())
  postenId        String    @map("posten_id")
  version         Int
  payload         Json
  gueltigVon      DateTime  @map("gueltig_von")
  gueltigBis      DateTime? @map("gueltig_bis")
  changedByUserId String    @map("changed_by_user_id")
  eventId         String?   @unique @map("event_id")

  posten Sicherungsposten @relation(fields: [postenId], references: [id], onDelete: Cascade)

  @@unique([postenId, version])
  @@map("sicherungsposten_versionen")
}

/// Vorfall-Meldung. `kontextSnapshot` ist authoritative Quelle für den historischen Stand (§B2).
/// FK auf `GefaehrdungsbeurteilungVersion` ist RESTRICT — Vorfall-Snapshot muss unveränderlich bleiben.
model EigenschutzVorfall {
  id                      String   @id @default(cuid())
  einsatzId               String   @map("einsatz_id")
  einheitId               String   @map("einheit_id")
  vorfallZeit             DateTime @map("vorfall_zeit")
  was                     String   @db.Text
  wann                    DateTime
  wo                      String   @db.VarChar(500)
  beteiligte              Json
  massnahmen              String   @db.Text
  unfallkasseRelevant     Boolean  @default(false) @map("unfallkasse_relevant")
  kontextSnapshot         Json     @map("kontext_snapshot")
  gefBeurteilungVersionId String?  @map("gef_beurteilung_version_id")
  erfasstAm               DateTime @default(now()) @map("erfasst_am")
  erfasstVonUserId        String   @map("erfasst_von_user_id")

  // Policy (Story 1.4 Review): Einsätze sollen NICHT hart löschbar sein. Falls doch (Maintenance, GDPR-Forget),
  // kaskadiert der Delete konsistent bis zum Vorfall — NICHT RESTRICT, da sonst der Einsatz-Delete am Vorfall-FK bricht.
  // Der `kontextSnapshot Json` bleibt erhalten, solange der Vorfall selbst nicht gelöscht wird.
  gefBeurteilungVersion GefaehrdungsbeurteilungVersion? @relation(fields: [gefBeurteilungVersionId], references: [id], onDelete: Cascade)

  @@index([einsatzId, einheitId])
  @@index([einsatzId, unfallkasseRelevant])
  @@index([vorfallZeit])
  @@map("eigenschutz_vorfaelle")
}

/// Telemetry-Event-Log (CBRN-Moment, Story 3.11). `eventName` ist String (TS-Union-Type in Application-Layer), kein DB-Enum.
model EigenschutzTelemetryEvent {
  id         String   @id @default(cuid())
  einsatzId  String   @map("einsatz_id")
  userId     String   @map("user_id")
  sessionId  String   @map("session_id") @db.VarChar(80)
  eventName  String   @map("event_name") @db.VarChar(80)
  payload    Json
  clientTime DateTime @map("client_time")
  serverTime DateTime @default(now()) @map("server_time")

  @@index([einsatzId, eventName])
  @@index([einsatzId, serverTime])
  @@map("eigenschutz_telemetry_events")
}

/// Read-Model für Ampel-Dashboard (Story 6.1, §B9). Composite-PK auf (einsatzId, einheitId).
model AmpelProjection {
  einsatzId                  String      @map("einsatz_id")
  einheitId                  String      @map("einheit_id")
  status                     Ampelstatus
  aktivePsaProfile           PsaProfil[] @map("aktive_psa_profile")
  offeneGefaehrdungenHoch    Int         @map("offene_gefaehrdungen_hoch")
  ausstehendePsaQuittungen   Int         @map("ausstehende_psa_quittungen")
  ausstehendeRegelQuittungen Int         @map("ausstehende_regel_quittungen")
  offeneVorfaelle            Int         @map("offene_vorfaelle")
  ungeloesteRueckmeldungen   Int         @map("ungeloeste_rueckmeldungen")
  letzteAenderungAm          DateTime    @map("letzte_aenderung_am")
  letzteAenderungVonUserId   String?     @map("letzte_aenderung_von_user_id")

  @@id([einsatzId, einheitId])
  @@index([einsatzId])
  @@map("ampel_projections")
}

/// Sync-Konflikt-Tabelle (Story 3.9/3.10). `resolvedAt`/`resolvedByUserId`/`resolution` bleiben null bis zur Auflösung.
model SyncConflict {
  id                   String                  @id @default(cuid())
  einsatzId            String                  @map("einsatz_id")
  einheitId            String?                 @map("einheit_id")
  entityType           SyncConflictEntityType  @map("entity_type")
  entityId             String                  @map("entity_id")
  fieldPath            String                  @map("field_path") @db.VarChar(200)
  localPayload         Json                    @map("local_payload")
  serverVersion        Int                     @map("server_version")
  localExpectedVersion Int                     @map("local_expected_version")
  reportedAt           DateTime                @default(now()) @map("reported_at")
  reportedByUserId     String                  @map("reported_by_user_id")
  resolvedAt           DateTime?               @map("resolved_at")
  resolvedByUserId     String?                 @map("resolved_by_user_id")
  resolution           SyncConflictResolution?

  @@index([einsatzId, resolvedAt])
  @@map("sync_conflicts")
}
