// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  USER
}

model User {
  id               String    @id @default(cuid())
  username         String    @unique @db.VarChar(100)
  passwordHash     String?   @db.Text // only admin users have a password
  role             UserRole  @default(USER)
  isActive         Boolean   @default(true)
  lastLoginAt      DateTime?
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Soft Delete Fields
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?   @db.VarChar(100)

  // Manual Lock Fields (admin-initiated, separate from auto-lock after failed logins)
  isLocked         Boolean   @default(false)
  lockedManuallyAt DateTime?
  lockedManuallyBy String?   @db.VarChar(100)
  lockReason       String?   @db.Text

  // Custom Permissions (JSON Array serialized as String)
  // Format: ["user:read", "einsatz:create", "etb:lock"]
  // NULL = no custom permissions (inherit from role only)
  permissions String? @db.Text

  // Relations
  // sessions        Session[]
  // refreshTokens   RefreshToken[]
  // rolePermissions RolePermission[]
  // loginAttempts   LoginAttempt[]
  // securityLogs    SecurityLog[]

  // Einsatz Relations
  createdEinsaetze  Einsatz[] @relation("EinsatzCreator")
  updatedEinsaetze  Einsatz[] @relation("EinsatzUpdater")
  archivedEinsaetze Einsatz[] @relation("EinsatzArchiver")

  // ETB Relations
  createdEtbs Einsatztagebuch[] @relation("EtbCreator")
  updatedEtbs Einsatztagebuch[] @relation("EtbUpdater")
  lockedEtbs  Einsatztagebuch[] @relation("EtbLocker")

  // ETB Eintrag Relations
  createdEtbEintraege EtbEintrag[] @relation("EtbEintragCreator")
  updatedEtbEintraege EtbEintrag[] @relation("EtbEintragUpdater")
  deletedEtbEintraege EtbEintrag[] @relation("EtbEintragDeleter")

  // ETB Historie Relations
  modifiedEtbHistorie EtbEintragHistorie[] @relation("EtbHistorieModifier")

  // ETB Textbaustein Relations
  createdEtbTextbausteine EtbTextbaustein[] @relation("EtbTextbausteinCreator")
  updatedEtbTextbausteine EtbTextbaustein[] @relation("EtbTextbausteinUpdater")

  // ETB Archiv Relations
  archivedEtbs EtbArchiv[] @relation("EtbArchivArchiver")

  // ========================================
  // Kräfte-Management Relations (Story 1.0)
  // ========================================

  // Qualifikation Relations
  createdQualifikationen Qualifikation[] @relation("QualifikationCreator")
  updatedQualifikationen Qualifikation[] @relation("QualifikationUpdater")

  // Fahrzeugtyp Relations
  createdFahrzeugtypen Fahrzeugtyp[] @relation("FahrzeugtypCreator")
  updatedFahrzeugtypen Fahrzeugtyp[] @relation("FahrzeugtypUpdater")

  // RollenDefinition Relations
  createdRollenDefinitionen RollenDefinition[] @relation("RollenDefinitionCreator")
  updatedRollenDefinitionen RollenDefinition[] @relation("RollenDefinitionUpdater")

  // FunkStatusConfig Relations
  createdFunkStatusConfigs FunkStatusConfig[] @relation("FunkStatusConfigCreator")
  updatedFunkStatusConfigs FunkStatusConfig[] @relation("FunkStatusConfigUpdater")

  // RolleQualifikation Relations
  createdRolleQualifikationen RolleQualifikation[] @relation("RolleQualifikationCreator")
  updatedRolleQualifikationen RolleQualifikation[] @relation("RolleQualifikationUpdater")

  // ========================================
  // Stammdaten Relations (Story 2.0)
  // ========================================

  // StammFahrzeug Relations
  createdStammFahrzeuge  StammFahrzeug[] @relation("StammFahrzeugCreator")
  updatedStammFahrzeuge  StammFahrzeug[] @relation("StammFahrzeugUpdater")
  archivedStammFahrzeuge StammFahrzeug[] @relation("StammFahrzeugArchiver")

  // StammPerson Relations
  createdStammPersonen  StammPerson[] @relation("StammPersonCreator")
  updatedStammPersonen  StammPerson[] @relation("StammPersonUpdater")
  archivedStammPersonen StammPerson[] @relation("StammPersonArchiver")

  // StammPersonQualifikation Relations (Junction Audit)
  createdStammPersonQualifikationen StammPersonQualifikation[] @relation("StammPersonQualifikationCreator")
  updatedStammPersonQualifikationen StammPersonQualifikation[] @relation("StammPersonQualifikationUpdater")

  // ========================================
  // Einsatz-Fahrzeuge Relations (Story 3.0)
  // ========================================
  createdEinsatzFahrzeuge EinsatzFahrzeug[] @relation("EinsatzFahrzeugCreator")
  updatedEinsatzFahrzeuge EinsatzFahrzeug[] @relation("EinsatzFahrzeugUpdater")

  // ========================================
  // Einsatz-Personen Relations (Story 4.0)
  // ========================================
  einsatzPersonenCreated              EinsatzPerson[]              @relation("EinsatzPersonCreator")
  einsatzPersonenUpdated              EinsatzPerson[]              @relation("EinsatzPersonUpdater")
  einsatzPersonQualifikationenCreated EinsatzPersonQualifikation[] @relation("EinsatzPersonQualifikationCreator")
  einsatzPersonQualifikationenUpdated EinsatzPersonQualifikation[] @relation("EinsatzPersonQualifikationUpdater")

  // ========================================
  // Rollen-Besetzung Relations (Story 5.0)
  // ========================================
  einsatzRollenbesetzungenCreated EinsatzRollenbesetzung[] @relation("EinsatzRollenbesetzungCreator")
  einsatzRollenbesetzungenUpdated EinsatzRollenbesetzung[] @relation("EinsatzRollenbesetzungUpdater")

  // ========================================
  // Invite-Code Relations (Story 1.6)
  // ========================================
  createdInviteCodes InviteCode[]

  // ========================================
  // Einsatz-Teilnehmer Relations (Story 115)
  // ========================================
  einsatzTeilnahmen EinsatzTeilnehmer[]

  // ========================================
  // Erinnerungen Relations (Story 1.1 Erinnerungen)
  // ========================================
  createdErinnerungen Erinnerung[] @relation("ErinnerungCreator")
  deletedErinnerungen Erinnerung[] @relation("ErinnerungDeleter") // Story 1.4: Soft-Delete Audit Trail

  // Indexes
  @@index([username], map: "idx_user_username")
  @@index([role, isActive], map: "idx_user_role_active")
  @@index([lastLoginAt], map: "idx_user_last_login")
  @@index([isDeleted], map: "idx_user_is_deleted")
  @@index([username, isDeleted], map: "idx_user_username_deleted")
  @@index([isLocked], map: "idx_user_is_locked")
  @@index([isActive, isDeleted, isLocked], map: "idx_user_status")
}

// Einsatz Status Enum
enum EinsatzStatus {
  ANGELEGT
  IN_BEARBEITUNG
  ABGESCHLOSSEN
  ARCHIVIERT
}

// Einsatz Model
model Einsatz {
  id               String        @id @default(cuid())
  alarmstichwort   String?       @db.VarChar(255)
  einsatzort       String?       @db.VarChar(500)
  beschreibung     String?       @db.Text
  alarmierungszeit DateTime?
  einsatzleiter    String?       @db.VarChar(255)
  status           EinsatzStatus @default(ANGELEGT)
  metadata         Json?         @db.JsonB

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String   @db.VarChar(100)
  updatedBy String?  @db.VarChar(100)

  // Archivierung (No-Delete Policy)
  archivedAt DateTime? // Zeitpunkt der Archivierung
  archivedBy String?   @db.VarChar(100) // Wer hat archiviert

  // Relations mit expliziten onDelete Direktiven
  creator  User  @relation("EinsatzCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater  User? @relation("EinsatzUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  archiver User? @relation("EinsatzArchiver", fields: [archivedBy], references: [id], onDelete: SetNull)

  // ETB Relation (1:1)
  einsatztagebuch Einsatztagebuch?

  // Lagekarte Relation (1:1)
  lagekarte Lagekarte?

  // Einsatz-Fahrzeuge Relation (1:N)
  einsatzFahrzeuge EinsatzFahrzeug[]

  // Einsatz-Personen Relation (1:N, Story 4.0)
  einsatzPersonen EinsatzPerson[]

  // Rollen-Besetzung Relation (1:N, Story 5.0)
  rollenBesetzungen EinsatzRollenbesetzung[]

  // Einsatz-Teilnehmer Relation (1:N, Story 115)
  teilnehmer EinsatzTeilnehmer[]

  // Erinnerungen Relation (1:N, Story 1.1 Erinnerungen)
  erinnerungen Erinnerung[]

  // Indexes
  @@index([status, createdAt])
  @@index([createdBy])
  @@map("einsaetze")
}

// ========================================
// ETB (Einsatztagebuch) Models
// ========================================

// ETB Status Enum
enum EtbStatus {
  DRAFT // Entwurf - kann bearbeitet werden
  ACTIVE // Aktiv - wird aktiv gepflegt
  LOCKED // Gesperrt - keine Änderungen mehr möglich
}

// Einsatztagebuch Model (1:1 mit Einsatz)
model Einsatztagebuch {
  id        String    @id @default(cuid())
  einsatzId String    @unique
  status    EtbStatus @default(DRAFT)
  lockedAt  DateTime? // Zeitpunkt der Sperrung
  lockedBy  String?   @db.VarChar(100) // User ID der Sperrung

  // Versionierung (für Optimistic Locking und Snapshot-Strategie)
  version            Int      @default(1) // Aktuelle Versionsnummer
  versionTimestamp   DateTime @default(now()) // Zeitpunkt der letzten Version
  nextSequenceNumber Int      @default(1) // Counter für Auto-Increment Sequenznummern

  // Zeitstempel
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String   @db.VarChar(100)
  updatedBy String?  @db.VarChar(100)

  // Relations
  einsatz Einsatz @relation(fields: [einsatzId], references: [id], onDelete: Restrict)
  creator User    @relation("EtbCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater User?   @relation("EtbUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  locker  User?   @relation("EtbLocker", fields: [lockedBy], references: [id], onDelete: SetNull)

  // ETB Einträge
  eintraege EtbEintrag[]

  // ETB Snapshots (Audit-Trail und Versionierung)
  snapshots EtbSnapshot[]

  // Indexes
  @@index([status, createdAt])
  @@index([createdBy])
  @@index([lockedAt])
  @@index([version])
  @@map("einsatztagebuecher")
}

// ETB Kategorie Enum für Einträge (DRK-spezifisch)
enum EtbKategorie {
  ALARMIERUNG // Alarmierungsmeldung
  ANKUNFT // Ankunft am Einsatzort
  BEFEHL // Befehle und Anweisungen
  ERKUNDUNG // Erkundungsergebnisse
  LAGE // Lagemeldungen
  MASSNAHME // Durchgeführte Maßnahmen
  PERSONAL // Personaländerungen
  FAHRZEUG // Fahrzeugbewegungen
  MATERIAL // Material- und Ausrüstungseinsatz
  KOMMUNIKATION // Kommunikation mit anderen Stellen
  WETTER // Wetteränderungen
  DOKUMENTATION // Dokumentarische Einträge (Screenshots, Fotos, Anhänge)
  SONSTIGES // Sonstige Einträge
  SYSTEM // Systemeinträge (automatisch)
}

// ETB Eintrag Model (n:1 mit Einsatztagebuch)
model EtbEintrag {
  id             String       @id @default(cuid())
  etbId          String // Einsatztagebuch ID
  timestamp      DateTime     @default(now()) // Zeitstempel des Eintrags
  sequenceNumber Int // Laufende Nummer innerhalb des ETB
  kategorie      EtbKategorie // Kategorie des Eintrags
  text           String       @db.Text // Eintragstext
  version        Int          @default(1) // Versionsnummer für Historie

  // Metadaten
  absender    String? @db.VarChar(100) // Absender des Eintrags (z.B. Funkrufname)
  empfaenger  String? @db.VarChar(100) // Empfänger des Eintrags (z.B. LST)
  standort    String? @db.VarChar(255) // Optionaler Standort
  isAutomatic Boolean @default(false) // Automatisch generierter Eintrag
  metadata    Json?   @db.JsonB // Zusätzliche strukturierte Daten

  // Zeitstempel
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String   @db.VarChar(100)
  updatedBy String?  @db.VarChar(100)

  // Soft Delete
  deletedAt DateTime? // Soft Delete Zeitstempel
  deletedBy String?   @db.VarChar(100) // User ID der Löschung

  // Relations
  einsatztagebuch Einsatztagebuch @relation(fields: [etbId], references: [id], onDelete: Cascade)
  creator         User            @relation("EtbEintragCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater         User?           @relation("EtbEintragUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  deleter         User?           @relation("EtbEintragDeleter", fields: [deletedBy], references: [id], onDelete: SetNull)

  // Historie
  historie EtbEintragHistorie[]

  // Indexes
  @@unique([etbId, sequenceNumber]) // Eindeutige laufende Nummer pro ETB
  @@index([etbId, timestamp])
  @@index([etbId, kategorie])
  @@index([createdBy])
  @@index([deletedAt])
  @@map("etb_eintraege")
}

// ETB Eintrag Historie Model (n:1 mit EtbEintrag)
model EtbEintragHistorie {
  id        String @id @default(cuid())
  eintragId String // ETB Eintrag ID
  version   Int // Versionsnummer

  // Snapshot der Daten
  timestamp      DateTime // Original Zeitstempel
  sequenceNumber Int // Original laufende Nummer
  kategorie      EtbKategorie // Original Kategorie
  text           String       @db.Text // Original Text
  absender       String?      @db.VarChar(100) // Absender des Eintrags
  empfaenger     String?      @db.VarChar(100) // Empfänger des Eintrags
  standort       String?      @db.VarChar(255)
  metadata       Json?        @db.JsonB

  // Änderungsinformationen
  changeReason String?  @db.Text // Grund der Änderung
  changedAt    DateTime @default(now()) // Zeitpunkt der Änderung
  changedBy    String   @db.VarChar(100) // User ID der Änderung

  // Relations
  eintrag  EtbEintrag @relation(fields: [eintragId], references: [id], onDelete: Cascade)
  modifier User       @relation("EtbHistorieModifier", fields: [changedBy], references: [id], onDelete: Restrict)

  // Indexes
  @@unique([eintragId, version]) // Eindeutige Version pro Eintrag
  @@index([eintragId, changedAt])
  @@index([changedBy])
  @@map("etb_eintrag_historie")
}

// ETB Textbaustein Model (für Quick-Entry Templates)
model EtbTextbaustein {
  id        String       @id @default(cuid())
  kategorie EtbKategorie // Kategorie für den Textbaustein
  kurztext  String       @db.VarChar(100) // Kurzbeschreibung
  volltext  String       @db.Text // Vollständiger Text
  isActive  Boolean      @default(true) // Aktiv/Inaktiv
  sortOrder Int          @default(0) // Sortierreihenfolge

  // Metadaten
  verwendungen Int       @default(0) // Anzahl der Verwendungen
  letztGenutzt DateTime? // Letzte Verwendung

  // Zeitstempel
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String   @db.VarChar(100)
  updatedBy String?  @db.VarChar(100)

  // Relations
  creator User  @relation("EtbTextbausteinCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater User? @relation("EtbTextbausteinUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@unique([kategorie, kurztext])
  // Indexes
  @@index([kategorie, isActive, sortOrder])
  @@index([createdBy])
  @@map("etb_textbausteine")
}

// ETB Snapshot Model (für Versionierung und Audit-Trail)
// Speichert einen kompletten Snapshot des ETB-Zustands VOR jeder Mutation
model EtbSnapshot {
  id            String   @id @default(cuid())
  etbId         String // FK zu Einsatztagebuch
  versionNumber Int // Versionsnummer die dieser Snapshot repräsentiert
  snapshotAt    DateTime @default(now()) // Zeitpunkt der Snapshot-Erstellung
  eintraege     Json     @db.JsonB // Array von EtbEintragSnapshot (kompletter State)

  // Relations
  einsatztagebuch Einsatztagebuch @relation(fields: [etbId], references: [id], onDelete: Cascade)

  // Indexes (Unique: Ein Snapshot pro Version pro ETB)
  @@unique([etbId, versionNumber])
  @@index([etbId, versionNumber])
  @@map("etb_snapshots")
}

// ETB Archiv Model (für 10-Jahre Aufbewahrung)
model EtbArchiv {
  id        String @id @default(cuid())
  einsatzId String // Original Einsatz ID
  etbId     String // Original ETB ID

  // Archivdaten
  archiveDatum    DateTime @default(now()) // Datum der Archivierung
  aufbewahrungBis DateTime // Datum bis zur Aufbewahrung (10 Jahre)

  // Vollständiger Export
  etbData       Json @db.JsonB // Komplettes ETB als JSON
  eintraegeData Json @db.JsonB // Alle Einträge als JSON
  historieData  Json @db.JsonB // Komplette Historie als JSON

  // Checksums für Integrität
  dataChecksum String @db.VarChar(64) // SHA-256 Hash

  // Speicherort (falls extern)
  storagePath String? @db.VarChar(500) // Pfad zu externem Archiv
  storageType String  @default("database") @db.VarChar(50) // database/filesystem/s3

  // Metadaten
  alarmstichwort   String?   @db.VarChar(255)
  einsatzort       String?   @db.VarChar(500)
  alarmierungszeit DateTime?
  einsatzleiter    String?   @db.VarChar(255)
  anzahlEintraege  Int // Anzahl der Einträge

  // Archivierungsinformationen
  archivedBy    String  @db.VarChar(100)
  archiveReason String? @db.Text // Grund der Archivierung

  // Relations
  archiver User @relation("EtbArchivArchiver", fields: [archivedBy], references: [id], onDelete: Restrict)

  // Indexes
  @@index([einsatzId])
  @@index([etbId])
  @@index([archiveDatum])
  @@index([aufbewahrungBis])
  @@index([archivedBy])
  @@map("etb_archiv")
}

// ========================================
// Lagekarte Models
// ========================================

// POI Type Enum für Lagekarte
enum PoiType {
  EINSATZORT // Haupt-Alarmierungsadresse
  EINSATZABSCHNITT // Abschnitt A, B, C
  EINSATZLEITUNG // Einsatzleitstelle, Führungsstelle
  FAHRZEUG // Statisch platzierte Fahrzeuge
  EINHEIT // Statisch platzierte Einheiten
  GEFAHRENQUELLE // Punktuelle Gefahr (z.B. Gasleck)
  SPERRBEREICH // Absperrpunkt
  VERSORGUNGSPUNKT // Wasser, Strom, Verpflegung
  BEREITSTELLUNGSRAUM // Bereitstellung von Einheiten/Material
  BEHANDLUNGSPLATZ // Verletzten-Versorgung
  SAMMELSTELLE // Betroffenen-/Helfer-Sammelpunkt
  UNTERKUNFT // Notunterkunft
  SONSTIGES // Custom POI

  @@map("poi_type")
}

// Lagekarte Model (1:1 mit Einsatz)
model Lagekarte {
  id        String   @id @default(cuid())
  einsatzId String   @unique
  state     Json     @default("{}") @db.JsonB // GeoJSON für Zeichnungen
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  einsatz Einsatz        @relation(fields: [einsatzId], references: [id], onDelete: Cascade)
  pois    LagekartePoi[]

  // Indexes
  @@index([einsatzId])
  @@map("lagekarte")
}

// ========================================
// Outbox Pattern Models (Transactional Outbox)
// ========================================

// Outbox Event Status Enum
enum OutboxEventStatus {
  PENDING // Event wartet auf Veröffentlichung
  PUBLISHED // Event erfolgreich veröffentlicht
  FAILED // Event dauerhaft fehlgeschlagen (nach max Retries)
}

// Outbox Event Model (Transactional Outbox Pattern für Event-Garantie)
// Events werden ATOMAR mit Aggregates persistiert, dann asynchron per Polling-Worker veröffentlicht.
// DRK Compliance: Kein Event-Verlust bei System-Crash zwischen save() und publish().
model OutboxEvent {
  id                String            @id @default(cuid())
  eventName         String            @db.VarChar(100) // z.B. "einsatz.created", "etb.eintrag_added"
  eventVersion      Int               @default(1) // Event-Versionierung für Schema-Evolution
  aggregateId       String            @db.VarChar(100) // ID des betroffenen Aggregates
  payload           Json              @db.JsonB // Serialisiertes Domain Event (JSON)
  status            OutboxEventStatus @default(PENDING)
  retryCount        Int               @default(0) // Anzahl fehlgeschlagener Versuche
  lastFailureReason String?           @db.Text // Letzte Fehlermeldung
  createdAt         DateTime          @default(now()) // Zeitpunkt der Persistierung
  occurredAt        DateTime // Zeitpunkt des Original-Events (aus DomainEvent)
  publishedAt       DateTime? // Zeitpunkt der erfolgreichen Veröffentlichung

  // Indexes für effizientes Polling
  @@index([status, createdAt], map: "idx_outbox_pending_poll") // Polling-Query: WHERE status=PENDING ORDER BY createdAt
  @@index([eventName], map: "idx_outbox_event_name") // Event-Type-Filterung
  @@index([aggregateId], map: "idx_outbox_aggregate_id") // Aggregate-basierte Queries
  @@map("outbox_events")
}

// Lagekarte POI Model (n:1 mit Lagekarte)
// KOORDINATENFORMAT:
// - MGRS (Military Grid Reference System) ist das PRIMÄRE Koordinatenformat
// - Latitude/Longitude wird aus MGRS berechnet und parallel gespeichert
// - Beide Formate werden gespeichert für Performance und Fallback-Kompatibilität
// - MGRS Format: z.B. "33UVU1234567890" (max. 20 Zeichen)
model LagekartePoi {
  id          String  @id @default(cuid())
  lagekarteId String
  type        PoiType
  name        String? @db.VarChar(255)
  adresse     String? @db.VarChar(500)

  // MGRS Koordinaten (primäres Format)
  mgrs String? @db.VarChar(20) // z.B. "33UVU1234567890", nullable für Migration

  // Lat/Lng Koordinaten (aus MGRS berechnet, Fallback für bestehende Daten)
  latitude  Float
  longitude Float

  icon      String?  @db.VarChar(50)
  metadata  Json?    @db.JsonB
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  lagekarte Lagekarte @relation(fields: [lagekarteId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([lagekarteId])
  @@index([type])
  @@index([mgrs]) // Schnelle MGRS-Suche
  @@map("lagekarte_poi")
}

// ========================================
// Kräfte-Management: Admin-Konfiguration
// Epic 1 - Story 1.0
// ========================================

// Qualifikation Kategorie Enum
enum QualifikationKategorie {
  FUEHRUNG // GF, ZF, VF - zählt als "Unterführer" in Stärkeberechnung
  SANITAET // RS, NotSan, NA - medizinische Qualifikationen
  BETREUUNG // z.B. Betreuungshelfer
  TECHNIK // Technik-Helfer
  SONSTIGES // Weitere
}

// Fahrzeugtyp Kategorie Enum (DIN EN 1789)
enum FahrzeugtypKategorie {
  RETTUNGSDIENST // RTW, KTW, NEF, NAW
  FUEHRUNG // ELW, MTW, FüKw
  TRANSPORT // GW, Anhänger
  SONSTIGES // Weitere
}

// Qualifikation Model (z.B. NotSan, RS, RH, GF, ZF)
// WICHTIG: abkuerzung @unique ist case-sensitive (PostgreSQL VARCHAR).
// "GF" und "gf" werden als unterschiedlich behandelt und sind beide erlaubt.
// Dies ist beabsichtigt, da Feuerwehr-Abkürzungen oft Groß-/Kleinschreibung unterscheiden.
model Qualifikation {
  id           String                 @id @default(cuid())
  name         String                 @db.VarChar(100) // z.B. "Notfallsanitäter"
  abkuerzung   String                 @unique @db.VarChar(20) // z.B. "NotSan" (case-sensitive unique constraint)
  kategorie    QualifikationKategorie
  beschreibung String?                @db.Text
  istAktiv     Boolean                @default(true)
  sortOrder    Int                    @default(0)

  // Audit-Trail (createdBy/updatedBy sind User.id FKs)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String   @db.VarChar(100)
  updatedBy String?  @db.VarChar(100)

  // Relations
  creator User  @relation("QualifikationCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater User? @relation("QualifikationUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)

  // M:N Relations
  rollenQualifikationen RolleQualifikation[]

  // M:N: Welche Stamm-Personen haben diese Qualifikation (Story 2.0)
  stammPersonQualifikationen StammPersonQualifikation[]

  // M:N: Einsatz-Personen mit dieser Qualifikation (Story 4.0)
  einsatzPersonQualifikationen EinsatzPersonQualifikation[]

  // 1:N: Externe Qualifikation-Mappings (Story 7.2)
  mappings QualifikationMapping[]

  // Indexes
  @@index([kategorie, istAktiv])
  @@index([istAktiv, sortOrder])
  @@index([createdBy])
  // TODO(Performance): Add composite index for filtered + sorted queries
  // Recommendation: @@index([istAktiv, sortOrder, name])
  // Use Case: findAll({ istAktiv: true }) with ORDER BY sortOrder ASC, name ASC
  // Impact: Optimiert Admin UI Qualifikationen-Tabelle (Story 1.1)
  @@map("qualifikationen")
}

// Fahrzeugtyp Model (z.B. RTW, KTW, NEF)
model Fahrzeugtyp {
  id            String               @id @default(cuid())
  code          String               @unique @db.VarChar(20) // z.B. "RTW"
  bezeichnung   String               @db.VarChar(100) // z.B. "Rettungswagen"
  kategorie     FahrzeugtypKategorie
  /// JSONB Schema: { fahrer?: number, sanitaeter?: number, notarzt?: number, funktrupp?: number, helfer?: number }
  /// Definiert die Soll-Besetzung pro Fahrzeugtyp für Einsatzplanung
  sollbesatzung Json?                @db.JsonB
  beschreibung  String?              @db.Text
  istAktiv      Boolean              @default(true)
  sortOrder     Int                  @default(0)

  // Audit-Trail
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String   @db.VarChar(100)
  updatedBy String?  @db.VarChar(100)

  // Relations
  creator User  @relation("FahrzeugtypCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater User? @relation("FahrzeugtypUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)

  // Inverse Relation für StammFahrzeuge (Story 2.0)
  stammFahrzeuge StammFahrzeug[]

  // Inverse Relation für EinsatzFahrzeuge (Story 3.0)
  einsatzFahrzeuge EinsatzFahrzeug[]

  // Indexes
  @@index([kategorie, istAktiv])
  @@index([istAktiv, sortOrder])
  @@index([createdBy])
  @@map("fahrzeugtypen")
}

// Rollen-Definition Model (z.B. LNA, OrgL, Leiter BHP)
model RollenDefinition {
  id           String  @id @default(cuid())
  name         String  @unique @db.VarChar(100) // z.B. "Leitender Notarzt"
  funkrufname  String? @db.VarChar(50) // z.B. "LNA"
  beschreibung String? @db.Text
  istAktiv     Boolean @default(true)
  sortOrder    Int     @default(0)

  // Audit-Trail
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String   @db.VarChar(100)
  updatedBy String?  @db.VarChar(100)

  // Relations
  creator User  @relation("RollenDefinitionCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater User? @relation("RollenDefinitionUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)

  // M:N: Erforderliche Qualifikationen für diese Rolle
  // Semantik: Person muss ALLE istPflicht=true Qualifikationen haben (UND-Verknüpfung)
  erforderlicheQualifikationen RolleQualifikation[]

  // Inverse Relation: Besetzungen dieser Rolle (Story 5.0)
  besetzungen EinsatzRollenbesetzung[]

  // Indexes
  @@index([istAktiv])
  @@index([istAktiv, sortOrder])
  @@index([istAktiv, sortOrder, name]) // Optimiert findAll mit Filter + vollständiger Sortierung
  @@index([createdBy])
  @@map("rollen_definitionen")
}

/// M:N Junction Table: Rolle <-> Qualifikation
/// Semantik: Person kann Rolle X ausüben, wenn sie ALLE Qualifikationen mit istPflicht=true besitzt (UND-Verknüpfung).
/// istPflicht=true: PFLICHT - Person MUSS diese Qualifikation haben
/// istPflicht=false: OPTIONAL - Empfohlen aber nicht erforderlich
model RolleQualifikation {
  id              String  @id @default(cuid())
  rolleId         String
  qualifikationId String
  istPflicht      Boolean @default(true) // true = Person MUSS haben, false = OPTIONAL/empfohlen

  // Audit-Trail
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String   @db.VarChar(100)
  updatedBy String?  @db.VarChar(100)

  // Relations
  rolle         RollenDefinition @relation(fields: [rolleId], references: [id], onDelete: Cascade)
  qualifikation Qualifikation    @relation(fields: [qualifikationId], references: [id], onDelete: Restrict)

  // Audit-Trail Relations
  creator User  @relation("RolleQualifikationCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater User? @relation("RolleQualifikationUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)

  // Unique Constraint (keine Duplikate in M:N)
  @@unique([rolleId, qualifikationId])
  @@index([rolleId])
  @@index([qualifikationId])
  @@index([rolleId, istPflicht])
  @@index([createdBy])
  @@map("rolle_qualifikationen")
}

// Funkstatus Konfiguration (Status 0-9 nach DIN-Norm, 7-9 konfigurierbar)
model FunkStatusConfig {
  id             String  @id @default(cuid())
  code           Int     @unique /// Status-Code 0-9 nach DIN-Norm. 0-6 sind standardisiert, 7-9 regional anpassbar.
  standardLabel  String  @db.VarChar(100) // DIN-Standard-Bezeichnung
  customLabel    String? @db.VarChar(100) // Mandanten-spezifische Anpassung
  farbe          String? @db.VarChar(7) // Hex-Farbe z.B. "#FF0000"
  istAlarmierbar Boolean @default(false) // Kann für Alarmierung genutzt werden
  beschreibung   String? @db.Text

  // Audit-Trail
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String   @db.VarChar(100)
  updatedBy String?  @db.VarChar(100)

  // Relations
  creator User  @relation("FunkStatusConfigCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater User? @relation("FunkStatusConfigUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)

  // Indexes
  @@index([code])
  @@index([istAlarmierbar])
  @@index([createdBy])
  @@map("funk_status_config")
}

// ========================================
// Kräfte-Management: Stammdaten
// Epic 2 - Story 2.0
// ========================================

/// Stamm-Fahrzeug: Dauerhaft registriertes Fahrzeug der Organisation
/// Referenziert von: EinsatzFahrzeug (Epic 3), Lagekarte-POIs (Epic 8)
model StammFahrzeug {
  id            String  @id @default(cuid())
  rufname       String  @db.VarChar(100) // z.B. "Rettungswagen 1"
  funkrufname   String  @unique @db.VarChar(50) // z.B. "Rotkreuz 83/1"
  fahrzeugtypId String // FK zu Fahrzeugtyp (Epic 1)
  kennzeichen   String? @db.VarChar(20) // z.B. "DA-RK 123"
  baujahr       Int? // z.B. 2022
  funkkenungBOS String? @db.VarChar(50) // BOS-Funkkennung

  // Archive-Pattern (NICHT isDeleted!)
  archivedAt DateTime?
  archivedBy String?   @db.VarChar(100)

  // Audit-Trail
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String   @db.VarChar(100)
  updatedBy String?  @db.VarChar(100)

  // Relations
  fahrzeugtyp Fahrzeugtyp @relation(fields: [fahrzeugtypId], references: [id], onDelete: Restrict)
  creator     User        @relation("StammFahrzeugCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater     User?       @relation("StammFahrzeugUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  archiver    User?       @relation("StammFahrzeugArchiver", fields: [archivedBy], references: [id], onDelete: SetNull)

  // Einsatz-Fahrzeuge Relation (1:N, für Rückverfolgbarkeit)
  einsatzFahrzeuge EinsatzFahrzeug[]

  // Indexes
  @@index([fahrzeugtypId])
  @@index([archivedAt])
  @@index([archivedAt, fahrzeugtypId])
  @@index([createdBy])
  @@map("stamm_fahrzeuge")
}

/// Stamm-Person: Dauerhaft registriertes Mitglied der Organisation
/// Referenziert von: EinsatzPerson (Epic 4), Rollenbesetzung (Epic 5)
model StammPerson {
  id             String  @id @default(cuid())
  vorname        String  @db.VarChar(100)
  nachname       String  @db.VarChar(100)
  personalnummer String  @unique @db.VarChar(50) // Eindeutige Personalnummer
  funkkenungBOS  String? @db.VarChar(50) // BOS-Funkkennung

  // Externe Integration (Story 7.2: HiOrg-Server Import)
  externalSource String?   @db.VarChar(50) // z.B. "HIORG_SERVER"
  externalId     String?   @db.VarChar(100) // z.B. HiOrg username
  lastSyncAt     DateTime? // Letzte Synchronisation aus externem System

  // Archive-Pattern (NICHT isDeleted!)
  archivedAt DateTime?
  archivedBy String?   @db.VarChar(100)

  // Audit-Trail
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String   @db.VarChar(100)
  updatedBy String?  @db.VarChar(100)

  // Relations
  creator  User  @relation("StammPersonCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater  User? @relation("StammPersonUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  archiver User? @relation("StammPersonArchiver", fields: [archivedBy], references: [id], onDelete: SetNull)

  // M:N: Qualifikationen dieser Person
  qualifikationen StammPersonQualifikation[]

  // Einsatz-Personen Relation (Story 4.0 - Rückverfolgbarkeit)
  einsatzPersonen EinsatzPerson[]

  @@unique([externalSource, externalId]) // Externe ID eindeutig pro Quelle
  // Indexes
  @@index([archivedAt])
  @@index([archivedAt, nachname])
  @@index([createdBy])
  @@map("stamm_personen")
}

/// M:N Junction Table: StammPerson <-> Qualifikation
/// Jede Qualifikation einer Person ist ein separater Eintrag mit Audit-Trail
model StammPersonQualifikation {
  id              String @id @default(cuid())
  personId        String
  qualifikationId String

  // Audit-Trail (wann wurde Qualifikation zugewiesen?)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String   @db.VarChar(100)
  updatedBy String?  @db.VarChar(100)

  // Relations
  person        StammPerson   @relation(fields: [personId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  qualifikation Qualifikation @relation(fields: [qualifikationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  creator       User          @relation("StammPersonQualifikationCreator", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updater       User?         @relation("StammPersonQualifikationUpdater", fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Unique Constraint (keine Duplikate in M:N)
  @@unique([personId, qualifikationId])
  @@index([personId])
  @@index([qualifikationId])
  @@index([createdBy])
  @@map("stamm_person_qualifikationen")
}

// ========================================
// Kräfte-Management: Einsatz-Fahrzeuge
// Epic 3 - Story 3.0
// ========================================

/// Einsatz-Fahrzeug: Snapshot eines Fahrzeugs im Einsatz-Kontext
/// - stammId nullable für spontane/temporäre Fahrzeuge
/// - funkrufname, kennzeichen werden KOPIERT (nicht live referenziert)
/// - Cascade-Delete mit Einsatz
model EinsatzFahrzeug {
  id            String  @id @default(cuid())
  einsatzId     String  @map("einsatz_id")
  stammId       String? @map("stamm_id")
  funkrufname   String  @db.VarChar(50)
  kennzeichen   String? @db.VarChar(20)
  fahrzeugtypId String  @map("fahrzeugtyp_id")
  fmsStatus     Int     @default(0) @map("fms_status")
  position      Json?   @db.JsonB

  // Audit Trail (PFLICHT)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String   @map("created_by") @db.VarChar(100)
  updatedBy String?  @map("updated_by") @db.VarChar(100)

  // Relations
  einsatz     Einsatz         @relation(fields: [einsatzId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  stamm       StammFahrzeug?  @relation(fields: [stammId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  fahrzeugtyp Fahrzeugtyp     @relation(fields: [fahrzeugtypId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  creator     User            @relation("EinsatzFahrzeugCreator", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updater     User?           @relation("EinsatzFahrzeugUpdater", fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  personen    EinsatzPerson[] // Epic 4 Story 4.3: Zugewiesene Personen (Rückwärts-Relation)

  // Constraints
  @@unique([einsatzId, funkrufname], name: "einsatz_fahrzeug_einsatz_funkrufname_unique")
  // Indexes
  @@index([einsatzId])
  @@index([stammId])
  @@index([fmsStatus])
  @@index([fahrzeugtypId])
  @@index([einsatzId, fmsStatus])
  @@index([einsatzId, fahrzeugtypId])
  @@index([createdBy])
  @@map("einsatz_fahrzeuge")
}

// ========================================
// Kräfte-Management: Einsatz-Personen
// Epic 4 - Story 4.0
// ========================================

/// Einsatz-Person: Snapshot einer Person im Einsatz-Kontext
/// - stammId nullable für spontane/temporäre Personen
/// - vorname, nachname, funkrufname werden KOPIERT (nicht live referenziert)
/// - Cascade-Delete mit Einsatz
model EinsatzPerson {
  id          String  @id @default(cuid())
  einsatzId   String  @map("einsatz_id")
  stammId     String? @map("stamm_id")
  fahrzeugId  String? @map("fahrzeug_id") // Epic 4 Story 4.3: Optional zugewiesenes Fahrzeug
  vorname     String  @db.VarChar(100)
  nachname    String  @db.VarChar(100)
  funkrufname String? @db.VarChar(50) // KOPIE von StammPerson.funkkenungBOS
  funktion    String  @db.VarChar(50) // Epic 4 AC1: Pflichtfeld (Helfer, Rettungshelfer, etc.)
  position    Json?   @db.JsonB

  // Audit Trail (PFLICHT - vollständig!)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at") // Auch für Optimistic Locking
  createdBy String   @map("created_by") @db.VarChar(100)
  updatedBy String?  @map("updated_by") @db.VarChar(100)

  // Relations (mit onUpdate: Cascade für Konsistenz)
  einsatz  Einsatz          @relation(fields: [einsatzId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  stamm    StammPerson?     @relation(fields: [stammId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  fahrzeug EinsatzFahrzeug? @relation(fields: [fahrzeugId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  creator  User             @relation("EinsatzPersonCreator", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updater  User?            @relation("EinsatzPersonUpdater", fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // M:N: Qualifikationen dieser Person (KOPIE zum Erfassungszeitpunkt)
  qualifikationen EinsatzPersonQualifikation[]

  // Inverse Relation: Rollen-Besetzungen dieser Person (Story 5.0)
  rollenBesetzungen EinsatzRollenbesetzung[]

  // Constraints
  @@unique([einsatzId, stammId], name: "einsatz_person_einsatz_stamm_unique")
  // Indexes
  @@index([einsatzId])
  @@index([stammId])
  @@index([fahrzeugId])
  @@index([einsatzId, nachname])
  @@index([createdBy])
  @@index([einsatzId, createdBy]) // Audit + Mission composite
  @@map("einsatz_personen")
}

/// M:N Junction Table: EinsatzPerson <-> Qualifikation
/// KOPIE der Qualifikationen zum Erfassungszeitpunkt
/// VOLLSTÄNDIGER Audit-Trail (auch für Junction Tables!)
model EinsatzPersonQualifikation {
  id              String @id @default(cuid())
  einsatzPersonId String @map("einsatz_person_id")
  qualifikationId String @map("qualifikation_id")

  // Audit-Trail (PFLICHT - auch für Junction Tables!)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String   @map("created_by") @db.VarChar(100)
  updatedBy String?  @map("updated_by") @db.VarChar(100)

  // Relations (mit onUpdate: Cascade)
  einsatzPerson EinsatzPerson @relation(fields: [einsatzPersonId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  qualifikation Qualifikation @relation(fields: [qualifikationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  creator       User          @relation("EinsatzPersonQualifikationCreator", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updater       User?         @relation("EinsatzPersonQualifikationUpdater", fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Unique Constraint (keine Duplikate in M:N)
  @@unique([einsatzPersonId, qualifikationId])
  @@index([einsatzPersonId])
  @@index([qualifikationId])
  @@index([qualifikationId, einsatzPersonId]) // Reverse-lookup composite
  @@index([createdBy])
  @@map("einsatz_person_qualifikationen")
}

// ========================================
// Kräfte-Management: Rollenbesetzung
// Epic 5 - Story 5.0
// ========================================

/// Rollenbesetzung: 1:1 Zuordnung Rolle → Person pro Einsatz
/// - Eine Rolle kann pro Einsatz nur EINMAL besetzt werden (AC2)
/// - Verhindert doppelte Besetzung via UNIQUE Constraint
/// - Cascade-Delete mit Einsatz (Einsatzdaten transient)
/// - Restrict-Delete für Person/Rolle (verhindert inkonsistente Daten)
model EinsatzRollenbesetzung {
  id                 String @id @default(cuid())
  einsatzId          String @map("einsatz_id")
  rollenDefinitionId String @map("rollen_definition_id")
  personId           String @map("person_id")

  // Snapshot-Felder (AC3: Historische Korrektheit für ETB-Einträge)
  // KOPIERT bei Erstellung, nicht live referenziert - Änderungen an
  // RollenDefinition/Person beeinflussen bestehende Besetzungen NICHT
  rollenName     String @map("rollen_name") @db.VarChar(100)
  personVorname  String @map("person_vorname") @db.VarChar(100)
  personNachname String @map("person_nachname") @db.VarChar(100)

  // Soft-Delete Felder (Story 5.2: Rolle freigeben)
  // freigegebenAm = null → Rolle aktiv besetzt
  // freigegebenAm = DateTime → Rolle freigegeben (Soft-Delete)
  freigegebenAm  DateTime? @map("freigegeben_am")
  freigegebenVon String?   @map("freigegeben_von") @db.VarChar(100)

  // Audit Trail (PFLICHT - vollständig!)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String   @map("created_by") @db.VarChar(100)
  updatedBy String?  @map("updated_by") @db.VarChar(100)

  // Relations (mit onUpdate: Cascade für Konsistenz)
  einsatz          Einsatz          @relation(fields: [einsatzId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  rollenDefinition RollenDefinition @relation(fields: [rollenDefinitionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  person           EinsatzPerson    @relation(fields: [personId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  creator          User             @relation("EinsatzRollenbesetzungCreator", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updater          User?            @relation("EinsatzRollenbesetzungUpdater", fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // UNIQUE Constraint (AC2): Pro Einsatz kann jede AKTIVE Rolle nur EINMAL besetzt werden
  // NOTE: Constraint erlaubt Re-Besetzung nach Freigabe (freigegebenAm != null)
  @@unique([einsatzId, rollenDefinitionId], name: "einsatz_rollen_besetzung_unique")
  // Indexes (Performance)
  @@index([einsatzId]) // Alle Rollen für Einsatz
  @@index([personId]) // Rollen einer Person
  @@index([rollenDefinitionId]) // Alle Personen mit Rolle X
  @@index([einsatzId, rollenDefinitionId]) // Composite für "Wer hat Rolle X in Einsatz Y"
  @@index([einsatzId, freigegebenAm]) // Aktive Besetzungen pro Einsatz (freigegebenAm = null)
  @@index([createdBy]) // Audit-Queries
  @@map("einsatz_rollen_besetzung")
}

// ========================================
// Integrations: Externe Dienste
// Epic 7 - Story 7.1
// ========================================

/// IntegrationCredential: Verschlüsselte Zugangsdaten für externe Dienste
/// - type ist UNIQUE (nur eine Konfiguration pro Integration)
/// - Token wird AES-256-GCM verschlüsselt gespeichert (Key aus ENV)
/// - API-Token wird NIEMALS in Responses oder Logs zurückgegeben
/// - Nutzt ausschließlich OAuth2-basierte Authentifizierung
model IntegrationCredential {
  id       String  @id @default(cuid())
  type     String  @unique @db.VarChar(50) // z.B. "HIORG_SERVER"
  isActive Boolean @default(true)

  lastTestedAt DateTime? // Letzter erfolgreicher Connection Test
  lastSyncAt   DateTime? // Letzte Synchronisation

  // OAuth2 Felder
  encryptedAccessToken  String?   @db.Text // Verschlüsseltes Access Token (AES-256-GCM)
  encryptedRefreshToken String?   @db.Text // Verschlüsseltes Refresh Token (AES-256-GCM)
  accessTokenExpiresAt  DateTime? // Access Token Ablaufzeit
  refreshTokenExpiresAt DateTime? // Refresh Token Ablaufzeit (optional, Provider-abhängig)
  oauthScopes           String?   @db.VarChar(500) // OAuth2 Scopes (space-separated)
  lastTokenRefreshAt    DateTime? // Letzter erfolgreicher Token Refresh

  // Audit-Trail
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.VarChar(100)
  updatedBy String?  @db.VarChar(100)

  // Indexes
  @@index([type])
  @@index([isActive])
  @@index([isActive, accessTokenExpiresAt]) // Für Token-Refresh-Scheduler mit Active-Filter
  @@map("integration_credentials")
}

/// OAuth2State: Temporärer State für CSRF-Schutz während OAuth Flow
/// - state ist ein kryptographisch sicherer Zufallswert (32 Bytes hex-encoded)
/// - codeVerifier wird für PKCE (Proof Key for Code Exchange) verwendet
/// - Einträge werden nach expiresAt automatisch bereinigt (5 Minuten TTL)
model OAuth2State {
  id              String   @id @default(cuid())
  state           String   @unique @db.VarChar(64) // Kryptographisch sicherer Zufallswert
  codeVerifier    String   @db.VarChar(128) // PKCE Code Verifier (Base64URL)
  integrationType String   @db.VarChar(50) // z.B. "HIORG_SERVER"
  redirectUri     String   @db.VarChar(500) // Callback URI nach OAuth Flow
  createdBy       String   @db.VarChar(100) // User der den Flow initiiert hat
  expiresAt       DateTime // State Ablaufzeit (typisch 5 Minuten)
  createdAt       DateTime @default(now())

  @@index([state]) // Schnelle Lookup bei Callback
  @@index([expiresAt]) // Für Cleanup-Job
  @@map("oauth2_states")
}

/// QualifikationMapping: Mapping externer Qualifikationen auf interne
/// Story 7.2: HiOrg-Server Import - Qualifikations-Mapping
/// - externalName: Name der Qualifikation im externen System (z.B. "Gruppenführer")
/// - externalSource: Quelle (z.B. "HIORG_SERVER")
/// - qualifikationId: FK auf interne Qualifikation (null = nicht gemappt)
/// - isAutoMatched: Automatisch via Levenshtein/exaktem Match gefunden?
/// - confidence: Konfidenz-Score (0-100) für Auto-Match
model QualifikationMapping {
  id              String  @id @default(cuid())
  externalName    String  @db.VarChar(200) // z.B. "Gruppenführer", "Sanitäter A"
  externalSource  String  @db.VarChar(50) // z.B. "HIORG_SERVER"
  qualifikationId String? // FK auf Qualifikation (null = nicht gemappt)
  isAutoMatched   Boolean @default(false) // Automatisch gemappt?
  confidence      Int? // Konfidenz-Score (0-100) für Auto-Match

  // Audit-Trail
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.VarChar(100)
  updatedBy String?  @db.VarChar(100)

  // Relations
  qualifikation Qualifikation? @relation(fields: [qualifikationId], references: [id], onDelete: SetNull)

  // Constraints
  @@unique([externalName, externalSource]) // Jeder externe Name pro Quelle einmalig
  @@index([externalSource])
  @@index([qualifikationId])
  @@index([externalSource, qualifikationId]) // Optimiert findUnmapped() Query
  @@map("qualifikation_mappings")
}

// ========================================
// Security: Server-Access-Token System
// Epic 1 - Story 1.1
// ========================================

/// ServerAccessToken: Token für Server-Zugriff via Access-Token-basierter Authentifizierung
/// - tokenHash: bcrypt Hash des Tokens (Format: $2[aby]$[cost]$[53 chars], exakt 60 Zeichen)
/// - Token Format: blh_{cuid2} (28 Zeichen total)
/// - Sicherheit: Cost Factor >= 10 (NFR-S1), Timing-Safe Comparison via bcrypt.compare()
model ServerAccessToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique @db.VarChar(60) // bcrypt Hash, exakt 60 Zeichen
  name       String?   @db.VarChar(100) // Optionale Beschreibung/Label für den Token
  lastUsedAt DateTime? // Letzter Verwendungszeitpunkt
  expiresAt  DateTime? // Ablaufzeitpunkt (NULL = never expires)
  isRevoked  Boolean   @default(false)
  revokedAt  DateTime? // Zeitpunkt der Revokation

  // InviteCode Relation (Story 1.6)
  inviteCodeId    String?     @unique
  createdByInvite InviteCode? @relation(fields: [inviteCodeId], references: [id])

  // Token Rotation (Story 4.4)
  rotatedFromId String?            @unique
  rotatedFrom   ServerAccessToken? @relation("TokenRotation", fields: [rotatedFromId], references: [id])
  rotatedTo     ServerAccessToken? @relation("TokenRotation")

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes für performante Queries
  @@index([tokenHash], map: "idx_server_access_token_hash") // Schnelle Token-Lookups
  @@index([tokenHash, isRevoked], map: "idx_server_access_token_validate") // validateToken Query
  @@index([isRevoked, expiresAt], map: "idx_server_access_token_active") // findActiveTokens Query
  @@index([rotatedFromId], map: "idx_server_access_token_rotated_from") // Token-Kette Queries
  @@map("server_access_tokens")
}

// ========================================
// Security: Invite-Code System
// Epic 1 - Story 1.6
// ========================================

/// InviteCode: Einmal- oder Mehrfach-Codes für Server-Zugang
/// - code: 8-stelliger alphanumerischer Code (Base32 ohne I/O/L zur Vermeidung von Verwechslungen)
/// - maxUses: Maximale Einlösungen (default 1 für Einmal-Code)
/// - useCount: Aktuelle Einlösungen
/// - Relation zu ServerAccessToken: 1:1 (ein Token pro erfolgreichem Einlösen)
model InviteCode {
  id          String    @id @default(cuid())
  code        String    @unique @db.VarChar(8)
  expiresAt   DateTime
  maxUses     Int       @default(1)
  useCount    Int       @default(0)
  isRevoked   Boolean   @default(false)
  revokedAt   DateTime?
  label       String?   @db.VarChar(100)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String    @db.VarChar(100)

  // Relations
  createdBy     User               @relation(fields: [createdById], references: [id], onDelete: Restrict)
  redeemedToken ServerAccessToken?

  // Indexes
  @@index([code], map: "idx_invite_code")
  @@index([expiresAt], map: "idx_invite_expires")
  @@index([createdById], map: "idx_invite_created_by")
  @@index([isRevoked, expiresAt], map: "idx_invite_active_codes")
  @@map("invite_codes")
}

// ========================================
// Server Configuration
// Story 4.6: INSECURE zu SECURE Migration
// ========================================

/// ServerConfig: Singleton-Konfiguration für Server-weite Einstellungen
/// - id = "singleton": Stellt sicher, dass nur eine Zeile existiert
/// - insecureMode: true = Server akzeptiert alle Requests ohne Authentifizierung
/// - migratedAt: Zeitpunkt der Migration von INSECURE zu SECURE Mode
///
/// **Warum Singleton-Pattern:**
/// - Genau eine Konfiguration pro Server-Instanz
/// - Einfache Abfrage via findUnique (keine Pagination nötig)
/// - Atomare Updates ohne Konfliktpotential
model ServerConfig {
  id           String    @id @default("singleton")
  insecureMode Boolean   @default(true)
  migratedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("server_config")
}

// ========================================
// Einsatz-Teilnehmer (Story 115)
// User-Funkrufname pro Einsatz
// ========================================

/// EinsatzTeilnehmer: Speichert den gewählten Funkrufnamen eines Users pro Einsatz
/// - Jeder User kann pro Einsatz nur einmal beitreten (@@unique)
/// - Funkrufname wird für ETB-Absender Auto-Fill verwendet
/// - leftAt wird gesetzt wenn User den Einsatz verlässt (Soft-Leave)
model EinsatzTeilnehmer {
  id          String    @id @default(cuid())
  einsatzId   String    @map("einsatz_id")
  userId      String    @map("user_id")
  funkrufname String    @db.VarChar(100)
  joinedAt    DateTime  @default(now()) @map("joined_at")
  leftAt      DateTime? @map("left_at")

  // Relations
  einsatz Einsatz @relation(fields: [einsatzId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Constraints: User kann pro Einsatz nur einmal beitreten
  @@unique([einsatzId, userId])
  // Indexes
  @@index([einsatzId])
  @@index([userId])
  @@index([einsatzId, leftAt]) // Aktive Teilnehmer pro Einsatz
  @@map("einsatz_teilnehmer")
}

// ========================================
// Erinnerungen (Story 1.1 - Quick Create)
// Epic 1: Persönliche Erinnerungen erstellen und bestätigen
// ========================================

/// Erinnerung Status Enum
/// Definiert den Lebenszyklus einer Erinnerung gemäß State Machine
enum ErinnerungStatus {
  GEPLANT // Initial: Erinnerung wartet auf Fälligkeit
  AUSGELOEST // Timer ist abgelaufen, Alarm wurde ausgelöst
  ACKNOWLEDGED // User hat Erinnerung bestätigt
  SNOOZED // Temporär verschoben (mit neuem Timer)
  ESKALIERT // An Eskalationsperson weitergeleitet
  ERLEDIGT // Abgeschlossen/Erledigt
}

/// Erinnerung: Zeitgesteuerte Benachrichtigung für FüKw-Personal
/// - Cascade-Delete mit Einsatz (Erinnerungen sind transient)
/// - Status-Transitions folgen der State Machine in ErinnerungStatus Value Object
/// - Timer wird client-seitig verwaltet, Server speichert nur State
model Erinnerung {
  id           String           @id @default(cuid())
  einsatzId    String           @map("einsatz_id")
  titel        String           @db.VarChar(100)
  beschreibung String?          @db.VarChar(500)
  faelligAm    DateTime         @map("faellig_am")
  status       ErinnerungStatus @default(GEPLANT)
  erstelltVon  String           @map("erstellt_von") @db.VarChar(100)

  // Audit Trail
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Soft-Delete (Story 1.4) - Keine physische Löschung (DRK-Compliance)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.VarChar(100)

  // Relations
  einsatz  Einsatz @relation(fields: [einsatzId], references: [id], onDelete: Cascade)
  ersteller User    @relation("ErinnerungCreator", fields: [erstelltVon], references: [id], onDelete: Restrict)
  loescher  User?   @relation("ErinnerungDeleter", fields: [deletedBy], references: [id], onDelete: Restrict)

  // Indexes
  @@index([einsatzId])
  @@index([einsatzId, faelligAm]) // Sortierte Abfrage nach Fälligkeit
  @@index([einsatzId, status]) // Filter nach Status
  @@index([status])
  @@index([erstelltVon])
  @@index([deletedAt]) // Effiziente Filterung für Soft-Delete (Story 1.4)
  @@map("erinnerungen")
}
