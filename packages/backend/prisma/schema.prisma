  name         String                         @db.VarChar(100)
  beschreibung String?                        @db.VarChar(500)
  scope        FuehrungsrhythmusTemplateScope @default(GLOBAL)
  einsatzId    String?                        @db.VarChar(30)

  // Audit Trail
  createdBy String   @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Soft-Delete
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?   @db.VarChar(100)

  // Relations
  creator   User                       @relation("FuehrungsrhythmusTemplateCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  deleter   User?                      @relation("FuehrungsrhythmusTemplateDeleter", fields: [deletedBy], references: [id], onDelete: Restrict)
  einsatz   Einsatz?                   @relation("FuehrungsrhythmusTemplateEinsatz", fields: [einsatzId], references: [id], onDelete: Restrict)
