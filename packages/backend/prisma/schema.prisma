// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  USER
}

model User {
  id               String    @id @default(cuid())
  username         String    @unique @db.VarChar(100)
  passwordHash     String?   @db.Text // only admin users have a password
  role             UserRole  @default(USER)
  isActive         Boolean   @default(true)
  lastLoginAt      DateTime?
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Soft Delete Fields
  isDeleted        Boolean   @default(false)
  deletedAt        DateTime?
  deletedBy        String?   @db.VarChar(100)

  // Manual Lock Fields (admin-initiated, separate from auto-lock after failed logins)
  isLocked         Boolean   @default(false)
  lockedManuallyAt DateTime?
  lockedManuallyBy String?   @db.VarChar(100)
  lockReason       String?   @db.Text

  // Relations
  // sessions        Session[]
  // refreshTokens   RefreshToken[]
  // rolePermissions RolePermission[]
  // loginAttempts   LoginAttempt[]
  // securityLogs    SecurityLog[]

  // Einsatz Relations
  createdEinsaetze  Einsatz[] @relation("EinsatzCreator")
  updatedEinsaetze  Einsatz[] @relation("EinsatzUpdater")
  archivedEinsaetze Einsatz[] @relation("EinsatzArchiver")

  // ETB Relations
  createdEtbs Einsatztagebuch[] @relation("EtbCreator")
  updatedEtbs Einsatztagebuch[] @relation("EtbUpdater")
  lockedEtbs  Einsatztagebuch[] @relation("EtbLocker")

  // ETB Eintrag Relations
  createdEtbEintraege EtbEintrag[] @relation("EtbEintragCreator")
  updatedEtbEintraege EtbEintrag[] @relation("EtbEintragUpdater")
  deletedEtbEintraege EtbEintrag[] @relation("EtbEintragDeleter")

  // ETB Historie Relations
  modifiedEtbHistorie EtbEintragHistorie[] @relation("EtbHistorieModifier")

  // ETB Textbaustein Relations
  createdEtbTextbausteine EtbTextbaustein[] @relation("EtbTextbausteinCreator")
  updatedEtbTextbausteine EtbTextbaustein[] @relation("EtbTextbausteinUpdater")

  // ETB Archiv Relations
  archivedEtbs EtbArchiv[] @relation("EtbArchivArchiver")

  // Indexes
  @@index([username], map: "idx_user_username")
  @@index([role, isActive], map: "idx_user_role_active")
  @@index([lastLoginAt], map: "idx_user_last_login")
  @@index([isDeleted], map: "idx_user_is_deleted")
  @@index([username, isDeleted], map: "idx_user_username_deleted")
  @@index([isLocked], map: "idx_user_is_locked")
  @@index([isActive, isDeleted, isLocked], map: "idx_user_status")
}

// Einsatz Status Enum
enum EinsatzStatus {
  ANGELEGT
  IN_BEARBEITUNG
  ABGESCHLOSSEN
  ARCHIVIERT
}

// Einsatz Model
model Einsatz {
  id               String        @id @default(cuid())
  alarmstichwort   String?       @db.VarChar(255)
  einsatzort       String?       @db.VarChar(500)
  beschreibung     String?       @db.Text
  alarmierungszeit DateTime?
  einsatzleiter    String?       @db.VarChar(255)
  status           EinsatzStatus @default(ANGELEGT)
  metadata         Json?         @db.JsonB

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String   @db.VarChar(100)
  updatedBy String?  @db.VarChar(100)

  // Archivierung (No-Delete Policy)
  archivedAt DateTime? // Zeitpunkt der Archivierung
  archivedBy String?   @db.VarChar(100) // Wer hat archiviert

  // Relations mit expliziten onDelete Direktiven
  creator  User  @relation("EinsatzCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater  User? @relation("EinsatzUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  archiver User? @relation("EinsatzArchiver", fields: [archivedBy], references: [id], onDelete: SetNull)

  // ETB Relation (1:1)
  einsatztagebuch Einsatztagebuch?

  // Lagekarte Relation (1:1)
  lagekarte Lagekarte?

  // Indexes
  @@index([status, createdAt])
  @@index([createdBy])
  @@map("einsaetze")
}

// ========================================
// ETB (Einsatztagebuch) Models
// ========================================

// ETB Status Enum
enum EtbStatus {
  DRAFT // Entwurf - kann bearbeitet werden
  ACTIVE // Aktiv - wird aktiv gepflegt
  LOCKED // Gesperrt - keine Änderungen mehr möglich
}

// Einsatztagebuch Model (1:1 mit Einsatz)
model Einsatztagebuch {
  id        String    @id @default(cuid())
  einsatzId String    @unique
  status    EtbStatus @default(DRAFT)
  lockedAt  DateTime? // Zeitpunkt der Sperrung
  lockedBy  String?   @db.VarChar(100) // User ID der Sperrung

  // Versionierung (für Optimistic Locking und Snapshot-Strategie)
  version            Int      @default(1) // Aktuelle Versionsnummer
  versionTimestamp   DateTime @default(now()) // Zeitpunkt der letzten Version
  nextSequenceNumber Int      @default(1) // Counter für Auto-Increment Sequenznummern

  // Zeitstempel
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String   @db.VarChar(100)
  updatedBy String?  @db.VarChar(100)

  // Relations
  einsatz Einsatz @relation(fields: [einsatzId], references: [id], onDelete: Restrict)
  creator User    @relation("EtbCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater User?   @relation("EtbUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  locker  User?   @relation("EtbLocker", fields: [lockedBy], references: [id], onDelete: SetNull)

  // ETB Einträge
  eintraege EtbEintrag[]

  // ETB Snapshots (Audit-Trail und Versionierung)
  snapshots EtbSnapshot[]

  // Indexes
  @@index([status, createdAt])
  @@index([createdBy])
  @@index([lockedAt])
  @@index([version])
  @@map("einsatztagebuecher")
}

// ETB Kategorie Enum für Einträge (DRK-spezifisch)
enum EtbKategorie {
  ALARMIERUNG // Alarmierungsmeldung
  ANKUNFT // Ankunft am Einsatzort
  BEFEHL // Befehle und Anweisungen
  ERKUNDUNG // Erkundungsergebnisse
  LAGE // Lagemeldungen
  MASSNAHME // Durchgeführte Maßnahmen
  PERSONAL // Personaländerungen
  FAHRZEUG // Fahrzeugbewegungen
  MATERIAL // Material- und Ausrüstungseinsatz
  KOMMUNIKATION // Kommunikation mit anderen Stellen
  WETTER // Wetteränderungen
  DOKUMENTATION // Dokumentarische Einträge (Screenshots, Fotos, Anhänge)
  SONSTIGES // Sonstige Einträge
  SYSTEM // Systemeinträge (automatisch)
}

// ETB Eintrag Model (n:1 mit Einsatztagebuch)
model EtbEintrag {
  id             String       @id @default(cuid())
  etbId          String // Einsatztagebuch ID
  timestamp      DateTime     @default(now()) // Zeitstempel des Eintrags
  sequenceNumber Int // Laufende Nummer innerhalb des ETB
  kategorie      EtbKategorie // Kategorie des Eintrags
  text           String       @db.Text // Eintragstext
  version        Int          @default(1) // Versionsnummer für Historie

  // Metadaten
  funkrufname String? @db.VarChar(100) // Optionaler Funkrufname
  standort    String? @db.VarChar(255) // Optionaler Standort
  isAutomatic Boolean @default(false) // Automatisch generierter Eintrag
  metadata    Json?   @db.JsonB // Zusätzliche strukturierte Daten

  // Zeitstempel
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String   @db.VarChar(100)
  updatedBy String?  @db.VarChar(100)

  // Soft Delete
  deletedAt DateTime? // Soft Delete Zeitstempel
  deletedBy String?   @db.VarChar(100) // User ID der Löschung

  // Relations
  einsatztagebuch Einsatztagebuch @relation(fields: [etbId], references: [id], onDelete: Cascade)
  creator         User            @relation("EtbEintragCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater         User?           @relation("EtbEintragUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  deleter         User?           @relation("EtbEintragDeleter", fields: [deletedBy], references: [id], onDelete: SetNull)

  // Historie
  historie EtbEintragHistorie[]

  // Indexes
  @@unique([etbId, sequenceNumber]) // Eindeutige laufende Nummer pro ETB
  @@index([etbId, timestamp])
  @@index([etbId, kategorie])
  @@index([createdBy])
  @@index([deletedAt])
  @@map("etb_eintraege")
}

// ETB Eintrag Historie Model (n:1 mit EtbEintrag)
model EtbEintragHistorie {
  id        String @id @default(cuid())
  eintragId String // ETB Eintrag ID
  version   Int // Versionsnummer

  // Snapshot der Daten
  timestamp      DateTime // Original Zeitstempel
  sequenceNumber Int // Original laufende Nummer
  kategorie      EtbKategorie // Original Kategorie
  text           String       @db.Text // Original Text
  funkrufname    String?      @db.VarChar(100)
  standort       String?      @db.VarChar(255)
  metadata       Json?        @db.JsonB

  // Änderungsinformationen
  changeReason String?  @db.Text // Grund der Änderung
  changedAt    DateTime @default(now()) // Zeitpunkt der Änderung
  changedBy    String   @db.VarChar(100) // User ID der Änderung

  // Relations
  eintrag  EtbEintrag @relation(fields: [eintragId], references: [id], onDelete: Cascade)
  modifier User       @relation("EtbHistorieModifier", fields: [changedBy], references: [id], onDelete: Restrict)

  // Indexes
  @@unique([eintragId, version]) // Eindeutige Version pro Eintrag
  @@index([eintragId, changedAt])
  @@index([changedBy])
  @@map("etb_eintrag_historie")
}

// ETB Textbaustein Model (für Quick-Entry Templates)
model EtbTextbaustein {
  id        String       @id @default(cuid())
  kategorie EtbKategorie // Kategorie für den Textbaustein
  kurztext  String       @db.VarChar(100) // Kurzbeschreibung
  volltext  String       @db.Text // Vollständiger Text
  isActive  Boolean      @default(true) // Aktiv/Inaktiv
  sortOrder Int          @default(0) // Sortierreihenfolge

  // Metadaten
  verwendungen Int       @default(0) // Anzahl der Verwendungen
  letztGenutzt DateTime? // Letzte Verwendung

  // Zeitstempel
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String   @db.VarChar(100)
  updatedBy String?  @db.VarChar(100)

  // Relations
  creator User  @relation("EtbTextbausteinCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater User? @relation("EtbTextbausteinUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@unique([kategorie, kurztext])
  // Indexes
  @@index([kategorie, isActive, sortOrder])
  @@index([createdBy])
  @@map("etb_textbausteine")
}

// ETB Snapshot Model (für Versionierung und Audit-Trail)
// Speichert einen kompletten Snapshot des ETB-Zustands VOR jeder Mutation
model EtbSnapshot {
  id            String   @id @default(cuid())
  etbId         String // FK zu Einsatztagebuch
  versionNumber Int // Versionsnummer die dieser Snapshot repräsentiert
  snapshotAt    DateTime @default(now()) // Zeitpunkt der Snapshot-Erstellung
  eintraege     Json     @db.JsonB // Array von EtbEintragSnapshot (kompletter State)

  // Relations
  einsatztagebuch Einsatztagebuch @relation(fields: [etbId], references: [id], onDelete: Cascade)

  // Indexes (Unique: Ein Snapshot pro Version pro ETB)
  @@unique([etbId, versionNumber])
  @@index([etbId, versionNumber])
  @@map("etb_snapshots")
}

// ETB Archiv Model (für 10-Jahre Aufbewahrung)
model EtbArchiv {
  id        String @id @default(cuid())
  einsatzId String // Original Einsatz ID
  etbId     String // Original ETB ID

  // Archivdaten
  archiveDatum    DateTime @default(now()) // Datum der Archivierung
  aufbewahrungBis DateTime // Datum bis zur Aufbewahrung (10 Jahre)

  // Vollständiger Export
  etbData       Json @db.JsonB // Komplettes ETB als JSON
  eintraegeData Json @db.JsonB // Alle Einträge als JSON
  historieData  Json @db.JsonB // Komplette Historie als JSON

  // Checksums für Integrität
  dataChecksum String @db.VarChar(64) // SHA-256 Hash

  // Speicherort (falls extern)
  storagePath String? @db.VarChar(500) // Pfad zu externem Archiv
  storageType String  @default("database") @db.VarChar(50) // database/filesystem/s3

  // Metadaten
  alarmstichwort   String?   @db.VarChar(255)
  einsatzort       String?   @db.VarChar(500)
  alarmierungszeit DateTime?
  einsatzleiter    String?   @db.VarChar(255)
  anzahlEintraege  Int // Anzahl der Einträge

  // Archivierungsinformationen
  archivedBy    String  @db.VarChar(100)
  archiveReason String? @db.Text // Grund der Archivierung

  // Relations
  archiver User @relation("EtbArchivArchiver", fields: [archivedBy], references: [id], onDelete: Restrict)

  // Indexes
  @@index([einsatzId])
  @@index([etbId])
  @@index([archiveDatum])
  @@index([aufbewahrungBis])
  @@index([archivedBy])
  @@map("etb_archiv")
}

// ========================================
// Lagekarte Models
// ========================================

// POI Type Enum für Lagekarte
enum PoiType {
  EINSATZORT // Haupt-Alarmierungsadresse
  EINSATZABSCHNITT // Abschnitt A, B, C
  EINSATZLEITUNG // Einsatzleitstelle, Führungsstelle
  FAHRZEUG // Statisch platzierte Fahrzeuge
  EINHEIT // Statisch platzierte Einheiten
  GEFAHRENQUELLE // Punktuelle Gefahr (z.B. Gasleck)
  SPERRBEREICH // Absperrpunkt
  VERSORGUNGSPUNKT // Wasser, Strom, Verpflegung
  BEREITSTELLUNGSRAUM // Bereitstellung von Einheiten/Material
  BEHANDLUNGSPLATZ // Verletzten-Versorgung
  SAMMELSTELLE // Betroffenen-/Helfer-Sammelpunkt
  UNTERKUNFT // Notunterkunft
  SONSTIGES // Custom POI

  @@map("poi_type")
}

// Lagekarte Model (1:1 mit Einsatz)
model Lagekarte {
  id        String   @id @default(cuid())
  einsatzId String   @unique
  state     Json     @default("{}") @db.JsonB // GeoJSON für Zeichnungen
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  einsatz Einsatz         @relation(fields: [einsatzId], references: [id], onDelete: Cascade)
  pois    LagekartePoi[]

  // Indexes
  @@index([einsatzId])
  @@map("lagekarte")
}

// ========================================
// Outbox Pattern Models (Transactional Outbox)
// ========================================

// Outbox Event Status Enum
enum OutboxEventStatus {
  PENDING // Event wartet auf Veröffentlichung
  PUBLISHED // Event erfolgreich veröffentlicht
  FAILED // Event dauerhaft fehlgeschlagen (nach max Retries)
}

// Outbox Event Model (Transactional Outbox Pattern für Event-Garantie)
// Events werden ATOMAR mit Aggregates persistiert, dann asynchron per Polling-Worker veröffentlicht.
// DRK Compliance: Kein Event-Verlust bei System-Crash zwischen save() und publish().
model OutboxEvent {
  id                String             @id @default(cuid())
  eventName         String             @db.VarChar(100) // z.B. "einsatz.created", "etb.eintrag_added"
  eventVersion      Int                @default(1) // Event-Versionierung für Schema-Evolution
  aggregateId       String             @db.VarChar(100) // ID des betroffenen Aggregates
  payload           Json               @db.JsonB // Serialisiertes Domain Event (JSON)
  status            OutboxEventStatus  @default(PENDING)
  retryCount        Int                @default(0) // Anzahl fehlgeschlagener Versuche
  lastFailureReason String?            @db.Text // Letzte Fehlermeldung
  createdAt         DateTime           @default(now()) // Zeitpunkt der Persistierung
  occurredAt        DateTime // Zeitpunkt des Original-Events (aus DomainEvent)
  publishedAt       DateTime? // Zeitpunkt der erfolgreichen Veröffentlichung

  // Indexes für effizientes Polling
  @@index([status, createdAt], map: "idx_outbox_pending_poll") // Polling-Query: WHERE status=PENDING ORDER BY createdAt
  @@index([eventName], map: "idx_outbox_event_name") // Event-Type-Filterung
  @@map("outbox_events")
}

// Lagekarte POI Model (n:1 mit Lagekarte)
// KOORDINATENFORMAT:
// - MGRS (Military Grid Reference System) ist das PRIMÄRE Koordinatenformat
// - Latitude/Longitude wird aus MGRS berechnet und parallel gespeichert
// - Beide Formate werden gespeichert für Performance und Fallback-Kompatibilität
// - MGRS Format: z.B. "33UVU1234567890" (max. 20 Zeichen)
model LagekartePoi {
  id          String   @id @default(cuid())
  lagekarteId String
  type        PoiType
  name        String?  @db.VarChar(255)
  adresse     String?  @db.VarChar(500)

  // MGRS Koordinaten (primäres Format)
  mgrs        String?  @db.VarChar(20) // z.B. "33UVU1234567890", nullable für Migration

  // Lat/Lng Koordinaten (aus MGRS berechnet, Fallback für bestehende Daten)
  latitude    Float
  longitude   Float

  icon        String?  @db.VarChar(50)
  metadata    Json?    @db.JsonB
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  lagekarte Lagekarte @relation(fields: [lagekarteId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([lagekarteId])
  @@index([type])
  @@index([mgrs]) // Schnelle MGRS-Suche
  @@map("lagekarte_poi")
}
