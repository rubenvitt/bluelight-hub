    "/api/v-1/befehle": {
      "get": {
        "description": "Gibt alle Befehle für den angegebenen Einsatz zurück, sortiert nach Erstellungszeitpunkt (neueste zuerst). Unterstützt erweiterte Filter: Status, Empfänger-Name, Befehlsgeber-Name, Freitextsuche (q) und Zeitraum (von/bis). hasOpenRueckfragen hat Vorrang vor empfaengerId. Erweiterte Filter haben Vorrang vor empfaengerId/hasOpenRueckfragen.",
        "operationId": "BefehlController_findByEinsatz_v-1",
        "parameters": [
          {
            "description": "ID des Einsatzes",
            "in": "query",
            "name": "einsatzId",
            "required": true,
            "schema": {
              "type": "string",
            },
          },
          {
            "description": "Optional: Filtert Befehle nach Empfänger-ID",
            "in": "query",
            "name": "empfaengerId",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
          {
            "description": "Filtert auf Befehle mit offenen Rückfragen",
            "in": "query",
            "name": "hasOpenRueckfragen",
            "required": false,
            "schema": {
              "type": "boolean",
            },
          },
          {
            "description": "Komma-separierte Status-Filter (ERTEILT,ZUGESTELLT,QUITTIERT,KORRIGIERT)",
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
          {
            "description": "Freitext-Filter auf Empfänger-Name (case-insensitive)",
            "in": "query",
            "name": "empfaengerName",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
          {
            "description": "Freitext-Filter auf Befehlsgeber-Name (case-insensitive)",
            "in": "query",
            "name": "befehlsgeberName",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
          {
            "description": "Volltextsuche über Auftrag (case-insensitive)",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
          {
            "description": "Zeitfilter: Befehle ab Datum (ISO 8601)",
            "in": "query",
            "name": "von",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
          {
            "description": "Zeitfilter: Befehle bis Datum (ISO 8601)",
            "in": "query",
            "name": "bis",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "items": {
                        "$ref": "#/components/schemas/BefehlDto",
                      },
                      "type": "array",
                    },
                    "meta": {
                      "properties": {
                        "requestId": {
                          "example": "abc123xyz",
                          "type": "string",
                        },
                        "timestamp": {
                          "example": "2025-08-29T14:00:00.000Z",
                          "format": "date-time",
                          "type": "string",
                        },
                        "version": {
                          "example": "alpha",
                          "type": "string",
                        },
                      },
                      "required": [
                        "timestamp",
                        "version",
                        "requestId",
                      ],
                      "type": "object",
                    },
                    "pagination": {
                      "properties": {
                        "limit": {
                          "example": 20,
                          "type": "number",
                        },
                        "page": {
                          "example": 1,
                          "type": "number",
                        },
                        "total": {
                          "example": 100,
                          "type": "number",
                        },
                        "totalPages": {
                          "example": 5,
                          "type": "number",
                        },
                      },
                      "type": "object",
                    },
                  },
                  "required": [
                    "data",
                    "meta",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Liste aller Befehle eines Einsatzes",
          },
          "400": {
            "description": "einsatzId fehlt oder ist ungültig",
          },
          "401": {
            "description": "Nicht authentifiziert - JWT Token fehlt oder ungültig",
          },
          "403": {
            "description": "Keine Berechtigung – Einsatz-Rolle nicht ausreichend",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "Befehle eines Einsatzes abrufen",
        "tags": [
          "Befehle",
        ],
      },
      "post": {
