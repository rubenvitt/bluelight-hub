            "example": "2026-02-23T10:29:00.000Z",
            "type": "object",
          },
          "lastSuccessAt": {
            "description": "Zeitpunkt des letzten erfolgreichen Calls (ISO 8601)",
            "example": "2026-02-23T10:29:00.000Z",
            "type": "object",
          },
          "responseTimeP95": {
            "description": "p95 Response Time in ms (letzte 5 Minuten)",
            "example": 120,
            "type": "number",
          },
          "serviceName": {
            "description": "Name des externen Services",
            "example": "hiorg-server",
            "type": "string",
          },
          "state": {
            "description": "Aktueller Circuit Breaker Zustand",
            "enum": [
              "CLOSED",
              "OPEN",
              "HALF_OPEN",
            ],
            "example": "CLOSED",
            "type": "string",
          },
        },
        "required": [
          "serviceName",
          "state",
          "failureCount",
        ],
        "type": "object",
      },
      "KorrigiereBefehlDto": {
        "properties": {
          "auftrag": {
            "description": "Auftrag (Pflicht, min 3 Zeichen)",
            "example": "Patientenablage einrichten",
            "type": "string",
          },
          "befehlsgeber": {
            "description": "Befehlsgeber Display-Name",
            "example": "EL Mueller",
            "type": "string",
          },
          "befehlsgeberId": {
            "description": "Befehlsgeber User-ID (optional, wenn Person als Befehlsgeber gewaehlt)",
            "example": "clw3h8x9y0005qwertyuiopas",
            "type": "string",
          },
          "empfaenger": {
            "description": "Empfaenger mit Name und optionaler User-ID (min 1)",
            "example": [
              {
                "empfaengerId": "clw3h8x9y0001qwertyuiopas",
                "name": "ZF Meier",
              },
              {
                "name": "Polizei",
              },
            ],
            "items": {
              "$ref": "#/components/schemas/CreateBefehlEmpfaengerDto",
            },
            "type": "array",
          },
          "ereignis": {
            "description": "Ereignis (EAMZW)",
            "example": "Wohnungsbrand im 2. OG",
            "type": "string",
          },
          "erstellerId": {
            "description": "Ersteller User-ID",
            "example": "clw3h8x9y0004qwertyuiopas",
            "type": "string",
          },
          "mittel": {
            "description": "Mittel (EAMZW)",
            "example": "2 Loeschzuege",
            "type": "string",
          },
          "weg": {
            "description": "Weg (EAMZW)",
            "example": "Ueber Haupteingang",
            "type": "string",
          },
          "zeitvorgabe": {
            "description": "Zeitvorgabe (optional)",
            "example": "15 min",
            "type": "string",
          },
          "ziel": {
            "description": "Ziel (EAMZW)",
            "example": "Brandbekaempfung",
            "type": "string",
          },
        },
        "required": [
          "empfaenger",
          "befehlsgeber",
          "erstellerId",
          "auftrag",
        ],
        "type": "object",
      },
      "LagekarteDto": {
        "properties": {
          "createdAt": {
            "description": "Erstellungszeitpunkt der Lagekarte",
            "example": "2024-01-15T12:00:00.000Z",
            "format": "date-time",
            "type": "string",
          },
          "einsatzId": {
            "description": "Referenz zum übergeordneten Einsatz",
            "example": "clw3h8x9y0000qwertyuiopas",
            "type": "string",
          },
          "id": {
            "description": "Eindeutige Lagekarten-ID (CUID)",
            "example": "clw3h8x9y0000qwertyuiopas",
            "type": "string",
          },
          "pois": {
            "description": "Liste aller POIs auf der Lagekarte",
            "items": {
              "items": {
                "type": "a",
              },
              "type": "array",
            },
            "type": "array",
          },
          "state": {
            "description": "GeoJSON FeatureCollection mit Zeichnungsdaten der Lagekarte",
            "example": {
              "features": [],
              "type": "FeatureCollection",
            },
            "nullable": true,
            "type": "object",
          },
          "updatedAt": {
            "description": "Letzter Aktualisierungszeitpunkt der Lagekarte",
            "example": "2024-01-15T14:30:00.000Z",
            "format": "date-time",
            "type": "string",
          },
        },
        "required": [
          "id",
          "einsatzId",
          "pois",
          "createdAt",
          "updatedAt",
        ],
        "type": "object",
      },
      "MeineEinsatzRolleDto": {
        "properties": {
          "permissions": {
            "allOf": [
              {
                "$ref": "#/components/schemas/BefehlPermissionsDto",
              },
            ],
            "description": "Abgeleitete Berechtigungen basierend auf der Rolle",
          },
          "rolle": {
            "description": "Zugewiesene Rolle im Einsatz (null wenn keine)",
            "enum": [
              "BEFEHLSGEBER",
              "ERSTELLER",
              "EMPFAENGER",
              "BEOBACHTER",
              "ADMIN",
              "SUPER_ADMIN",
            ],
            "example": "BEFEHLSGEBER",
            "nullable": true,
            "type": "string",
          },
        },
        "required": [
          "rolle",
          "permissions",
        ],
        "type": "object",
      },
      "NavigationResponseDto": {
        "properties": {
          "id": {
            "description": "ID des vorherigen/naechsten Einsatzes",
            "example": "clw3h8x9y0000qwertyuiopas",
            "nullable": true,
            "type": "object",
          },
        },
        "required": [
          "id",
        ],
        "type": "object",
      },
      "PatientKontextDto": {
        "properties": {
          "kind": {
            "description": "Ereignis-Typ des Patienten",
            "enum": [
              "patient.erfasst",
              "patient.gesichtet",
              "patient.sichtung-aktualisiert",
              "patient.behandlung-begonnen",
              "patient.behandlung-abgeschlossen",
              "patient.transport-gestartet",
              "patient.transport-abgeschlossen",
              "patient.korrigiert",
            ],
            "example": "patient.erfasst",
            "type": "string",
          },
          "patientId": {
            "description": "Referenzierte Patient-ID",
            "example": "clpatient...",
            "type": "string",
          },
          "patientennummer": {
            "description": "Patientennummer",
            "example": "P-003",
            "type": "string",
          },
          "payload": {
            "additionalProperties": true,
            "description": "Zusatzdaten des Ereignisses (z. B. Sichtung, Priorität, etc.)",
            "example": {},
            "type": "object",
          },
          "type": {
            "enum": [
              "patient",
            ],
            "example": "patient",
            "type": "string",
          },
        },
        "required": [
          "type",
          "kind",
          "patientId",
          "patientennummer",
          "payload",
        ],
        "type": "object",
      },
      "QuittierenBefehlDto": {
        "properties": {
          "empfaengerId": {
            "description": "ID des quittierenden Empfaengers",
            "example": "clw3h8x9y0001qwertyuiopas",
            "type": "string",
          },
          "kommentar": {
            "description": "Optionaler Kommentar zur Quittierung (z.B. Rueckfrage-Text)",
            "type": "string",
          },
          "quittierungArt": {
            "description": "Art der Quittierung",
            "enum": [
              "VERSTANDEN",
              "RUECKFRAGE",
              "NICHT_VERSTANDEN",
            ],
            "example": "VERSTANDEN",
            "type": "string",
          },
        },
        "required": [
          "empfaengerId",
          "quittierungArt",
        ],
        "type": "object",
      },
      "RollenZuweisungDto": {
        "properties": {
          "rolle": {
            "description": "Zuzuweisende Rolle",
            "enum": [
              "BEFEHLSGEBER",
              "ERSTELLER",
              "EMPFAENGER",
              "BEOBACHTER",
            ],
            "example": "BEFEHLSGEBER",
            "type": "string",
          },
          "userId": {
            "description": "User-ID (CUID2)",
            "example": "clw3h8x9y0000qwertyuiopas",
            "type": "string",
          },
        },
        "required": [
          "userId",
          "rolle",
        ],
        "type": "object",
      },
      "StandardKontextDto": {
        "properties": {
          "type": {
            "enum": [
              "standard",
            ],
            "example": "standard",
            "type": "string",
          },
        },
        "required": [
          "type",
        ],
        "type": "object",
      },
      "StatusCountsDto": {
        "properties": {
          "abgeschlossen": {
            "description": "Anzahl der Einsaetze mit Status ABGESCHLOSSEN",
            "example": 8,
            "type": "number",
          },
          "angelegt": {
            "description": "Anzahl der Einsaetze mit Status ANGELEGT",
            "example": 10,
            "type": "number",
          },
          "archiviert": {
            "description": "Anzahl der Einsaetze mit Status ARCHIVIERT",
            "example": 12,
            "type": "number",
          },
          "inBearbeitung": {
            "description": "Anzahl der Einsaetze mit Status IN_BEARBEITUNG",
            "example": 5,
            "type": "number",
          },
        },
        "required": [
          "angelegt",
          "inBearbeitung",
          "abgeschlossen",
          "archiviert",
        ],
        "type": "object",
      },
      "StatusCountsResponseDto": {
        "properties": {
          "counts": {
            "allOf": [
              {
                "$ref": "#/components/schemas/StatusCountsDto",
              },
            ],
            "description": "Anzahl der Einsaetze pro Status",
          },
          "total": {
            "description": "Gesamtanzahl aller Einsaetze",
            "example": 35,
            "type": "number",
          },
        },
        "required": [
          "total",
          "counts",
        ],
        "type": "object",
      },
      "SystemHealthDto": {
        "properties": {
          "apiResponseTime": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ApiResponseTimeDto",
              },
            ],
            "description": "API Response Times (p50, p95, p99) in ms",
          },
          "circuitBreakerStatus": {
            "description": "Status pro Integration (CLOSED/OPEN/HALF_OPEN)",
            "items": {
              "$ref": "#/components/schemas/CircuitBreakerStatusEntryDto",
            },
            "type": "array",
          },
          "dbConnectionPoolUsage": {
            "description": "DB-Connection-Pool-Auslastung in Prozent",
            "example": 45,
            "type": "number",
          },
          "outboxQueueDepth": {
            "description": "Anzahl wartender Events im Outbox",
            "example": 3,
            "type": "number",
          },
          "uptime": {
            "description": "Server-Uptime in Sekunden",
            "example": 86400,
            "type": "number",
          },
          "websocketConnections": {
            "description": "Anzahl aktiver WebSocket-Verbindungen",
            "example": 42,
            "type": "number",
          },
          "zustellrate": {
            "description": "Prozent erfolgreich zugestellter Befehle im 5min-Window (Ziel: >99%)",
            "example": 99.5,
            "type": "number",
          },
        },
        "required": [
          "zustellrate",
          "websocketConnections",
          "outboxQueueDepth",
          "apiResponseTime",
          "circuitBreakerStatus",
          "dbConnectionPoolUsage",
          "uptime",
        ],
        "type": "object",
      },
      "UpdateEinsatzDto": {
        "properties": {
          "alarmierungszeit": {
            "description": "Zeitpunkt der Alarmierung",
            "example": "2024-01-15T10:30:00.000Z",
            "format": "date-time",
            "type": "string",
          },
          "alarmstichwort": {
            "description": "Das Alarmstichwort des Einsatzes",
            "example": "Wohnungsbrand",
            "maxLength": 255,
            "type": "string",
          },
          "beschreibung": {
            "description": "Beschreibung des Einsatzes",
            "example": "Rauchentwicklung im 2. OG, keine Personen in Gefahr",
            "type": "string",
          },
          "einsatzleiter": {
            "description": "Name des Einsatzleiters",
            "example": "Max Mustermann",
            "maxLength": 255,
            "type": "string",
          },
          "einsatzort": {
            "description": "Der Einsatzort",
            "example": "Musterstrasse 123, 80331 Muenchen",
            "maxLength": 500,
            "type": "string",
          },
          "metadata": {
            "additionalProperties": true,
            "description": "Zusaetzliche Metadaten als JSON",
            "example": {
              "notizen": "Wichtiger Hinweis",
              "prioritaet": "hoch",
            },
            "type": "object",
          },
          "status": {
            "description": "Status des Einsatzes",
            "enum": [
              "ANGELEGT",
              "IN_BEARBEITUNG",
              "ABGESCHLOSSEN",
              "ARCHIVIERT",
            ],
            "example": "IN_BEARBEITUNG",
            "type": "string",
          },
        },
        "type": "object",
      },
      "UpdateEinsatzRollenDto": {
        "properties": {
          "zuweisungen": {
            "description": "Array von Rollenzuweisungen",
            "items": {
              "$ref": "#/components/schemas/RollenZuweisungDto",
            },
            "type": "array",
          },
        },
        "required": [
          "zuweisungen",
        ],
        "type": "object",
      },
    },
    "securitySchemes": {
      "admin-jwt": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http",
      },
      "server-access-token": {
        "in": "header",
        "name": "X-Server-Access-Token",
        "type": "apiKey",
      },
    },
  },
  "info": {
    "contact": {},
    "description": "Stabile API-Vertraege fuer externe Integrationen.",
    "title": "BlueLight Hub API v1 (Stable)",
    "version": "NORMALIZED",
  },
  "openapi": "3.0.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/BasicHealthDto",
                    },
                    {
                      "$ref": "#/components/schemas/DetailedHealthDto",
                    },
                  ],
                },
              },
            },
            "description": "Ohne Token: BasicHealthDto, Mit Token: DetailedHealthDto",
          },
        },
        "summary": "Health-Check mit Token-Differenzierung",
        "tags": [
          "Health",
        ],
      },
    },
    "/api/health/db": {
      "get": {
        "operationId": "HealthController_checkDatabase",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "details": {
                      "additionalProperties": {
                        "additionalProperties": true,
                        "properties": {
                          "status": {
                            "type": "string",
                          },
                        },
                        "required": [
                          "status",
                        ],
                        "type": "object",
                      },
                      "example": {
                        "database": {
                          "status": "up",
                        },
                      },
                      "type": "object",
                    },
                    "error": {
                      "additionalProperties": {
                        "additionalProperties": true,
                        "properties": {
                          "status": {
                            "type": "string",
                          },
                        },
                        "required": [
                          "status",
                        ],
                        "type": "object",
                      },
                      "example": {},
                      "nullable": true,
                      "type": "object",
                    },
                    "info": {
                      "additionalProperties": {
                        "additionalProperties": true,
                        "properties": {
                          "status": {
                            "type": "string",
                          },
                        },
                        "required": [
                          "status",
                        ],
                        "type": "object",
                      },
                      "example": {
                        "database": {
                          "status": "up",
                        },
                      },
                      "nullable": true,
                      "type": "object",
                    },
                    "status": {
                      "example": "ok",
                      "type": "string",
                    },
                  },
                  "type": "object",
                },
              },
            },
            "description": "The Health Check is successful",
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "details": {
                      "additionalProperties": {
                        "additionalProperties": true,
                        "properties": {
                          "status": {
                            "type": "string",
                          },
                        },
                        "required": [
                          "status",
                        ],
                        "type": "object",
                      },
                      "example": {
                        "database": {
                          "status": "up",
                        },
                        "redis": {
                          "message": "Could not connect",
                          "status": "down",
                        },
                      },
                      "type": "object",
                    },
                    "error": {
                      "additionalProperties": {
                        "additionalProperties": true,
                        "properties": {
                          "status": {
                            "type": "string",
                          },
                        },
                        "required": [
                          "status",
                        ],
                        "type": "object",
                      },
                      "example": {
                        "redis": {
                          "message": "Could not connect",
                          "status": "down",
                        },
                      },
                      "nullable": true,
                      "type": "object",
                    },
                    "info": {
                      "additionalProperties": {
                        "additionalProperties": true,
                        "properties": {
                          "status": {
                            "type": "string",
                          },
                        },
                        "required": [
                          "status",
                        ],
                        "type": "object",
                      },
                      "example": {
                        "database": {
                          "status": "up",
                        },
                      },
                      "nullable": true,
                      "type": "object",
                    },
                    "status": {
                      "example": "error",
                      "type": "string",
                    },
                  },
                  "type": "object",
                },
              },
            },
            "description": "The Health Check is not successful",
          },
        },
        "tags": [
          "Health",
        ],
      },
    },
    "/api/health/integrations": {
      "get": {
        "operationId": "HealthController_getIntegrationHealth",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/IntegrationHealthDto",
                    },
                    "meta": {
                      "properties": {
                        "requestId": {
                          "example": "abc123xyz",
                          "type": "string",
                        },
                        "timestamp": {
                          "example": "2025-08-29T14:00:00.000Z",
                          "format": "date-time",
                          "type": "string",
                        },
                        "version": {
                          "example": "alpha",
                          "type": "string",
                        },
                      },
                      "required": [
                        "timestamp",
                        "version",
                        "requestId",
                      ],
                      "type": "object",
                    },
                  },
                  "required": [
                    "data",
                    "meta",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Status aller externen Integrationen",
          },
        },
        "summary": "Circuit Breaker Status aller externen Integrationen",
        "tags": [
          "Health",
        ],
      },
    },
