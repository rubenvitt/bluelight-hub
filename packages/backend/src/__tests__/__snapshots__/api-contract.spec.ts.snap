      "EintragDto": {
        "properties": {
          "absender": {
            "description": "Absender des Eintrags (z.B. Funkrufname)",
            "example": "Rotkreuz 83/1",
            "maxLength": 100,
            "nullable": true,
            "type": "string",
          },
          "createdAt": {
            "description": "Erstellungszeitpunkt des Eintrags (technischer Timestamp)",
            "example": "2024-01-15T12:00:00.000Z",
            "format": "date-time",
            "type": "string",
          },
          "createdBy": {
            "description": "User-ID des Erstellers (Referenz)",
            "example": "clw3h8x9y0000qwertyuiopas",
            "type": "string",
          },
          "deletedAt": {
            "description": "Soft-Delete-Zeitpunkt (wann wurde der Eintrag gelöscht)",
            "example": "2024-01-15T13:00:00.000Z",
            "format": "date-time",
            "nullable": true,
            "type": "string",
          },
          "deletedBy": {
            "description": "User-ID des Löschenden (Referenz)",
            "example": "clw3h8x9y0000qwertyuiopas",
            "nullable": true,
            "type": "string",
          },
          "deleterUsername": {
            "description": "Username des Löschenden (aus User-Join)",
            "example": "max.mustermann",
            "nullable": true,
            "type": "string",
          },
          "empfaenger": {
            "description": "Empfänger des Eintrags (z.B. LST, Polizei)",
            "example": "LST Darmstadt",
            "maxLength": 100,
            "nullable": true,
            "type": "string",
          },
          "ereignisZeitpunkt": {
            "description": "Fachlicher Ereignis-Zeitstempel (überschreibt timestamp wenn explizit gesetzt)",
            "example": "2024-01-15T11:55:00.000Z",
            "format": "date-time",
            "type": "string",
          },
          "erfasstAm": {
            "description": "Technischer Erfassungszeitstempel (entspricht meist createdAt)",
            "example": "2024-01-15T12:00:00.000Z",
            "format": "date-time",
            "type": "string",
          },
          "id": {
            "description": "Eindeutige Eintrags-ID (CUID)",
            "example": "clw3h8x9y0000qwertyuiopas",
            "type": "string",
          },
          "isAutomatic": {
            "description": "Flag für automatisch generierte Einträge (z.B. durch System-Events)",
            "example": false,
            "type": "boolean",
          },
          "isDeleted": {
            "description": "Soft-Delete-Flag (Einträge werden nie physisch gelöscht)",
            "example": false,
            "type": "boolean",
          },
          "isKorrektur": {
            "description": "true wenn dieser Eintrag ein Korrektur-Eintrag ist",
            "example": false,
            "type": "boolean",
          },
          "isKorrigiert": {
            "description": "true wenn dieser Eintrag durch einen Korrektur-Eintrag ersetzt wurde",
            "example": false,
            "type": "boolean",
          },
          "kategorie": {
            "description": "Kategorie des Eintrags",
            "enum": [
              "ALARMIERUNG",
              "ANKUNFT",
              "BEFEHL",
              "ERKUNDUNG",
              "LAGE",
              "MASSNAHME",
              "PERSONAL",
              "FAHRZEUG",
              "MATERIAL",
              "KOMMUNIKATION",
              "WETTER",
              "DOKUMENTATION",
              "SONSTIGES",
              "SYSTEM",
            ],
            "example": "LAGE",
            "type": "string",
          },
          "kontext": {
            "description": "Eintrag-Kontext (discriminated union: standard | funkspruch)",
            "discriminator": {
              "mapping": {
                "funkspruch": "#/components/schemas/FunkKontextDto",
                "patient": "#/components/schemas/PatientKontextDto",
                "standard": "#/components/schemas/StandardKontextDto",
              },
              "propertyName": "type",
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/StandardKontextDto",
              },
              {
                "$ref": "#/components/schemas/FunkKontextDto",
              },
              {
                "$ref": "#/components/schemas/PatientKontextDto",
              },
            ],
          },
          "korrigiertDurchId": {
            "description": "ID des Korrektur-Eintrags der diesen Eintrag ersetzt",
            "example": "clw3h8x9y0000qwertyuiopas",
            "nullable": true,
            "type": "string",
          },
          "korrigiertEintragId": {
            "description": "ID des Original-Eintrags den dieser Korrektur-Eintrag korrigiert",
            "example": "clw3h8x9y0000qwertyuiopas",
            "nullable": true,
            "type": "string",
          },
          "linkedErinnerung": {
            "description": "Verknüpfte Erinnerung (Story 5.4)",
            "example": {
              "id": "clw3h8x9y0000qwertyuiopas",
              "titel": "Follow-up Leitstelle",
            },
            "nullable": true,
            "type": "object",
          },
          "metadata": {
            "description": "Optionale Metadaten (z.B. Screenshots, Anhänge)",
            "example": {
              "screenshot": {
                "height": 768,
                "url": "/uploads/lagekarte/einsatz_123.png",
                "width": 1024,
              },
            },
            "nullable": true,
            "type": "object",
          },
          "sequenceNumber": {
            "description": "Sequenznummer für deterministische Reihenfolge",
            "example": 1,
            "minimum": 1,
            "type": "number",
          },
          "standort": {
            "description": "Optionaler Standort der Einheit",
            "example": "Hauptstraße 123",
            "maxLength": 255,
            "nullable": true,
            "type": "string",
          },
          "text": {
            "description": "Eintragungstext (Freitext)",
            "example": "Einsatzkräfte vor Ort eingetroffen",
            "type": "string",
          },
          "timestamp": {
            "description": "Fachlicher Zeitstempel des Eintrags (wann ist das Ereignis eingetreten)",
            "example": "2024-01-15T12:00:00.000Z",
            "format": "date-time",
            "type": "string",
          },
          "updatedAt": {
            "description": "Letzter Aktualisierungszeitpunkt (nur bei Editierung)",
            "example": "2024-01-15T12:30:00.000Z",
            "format": "date-time",
            "nullable": true,
            "type": "string",
          },
          "updatedBy": {
            "description": "User-ID des letzten Editors (Referenz)",
            "example": "clw3h8x9y0000qwertyuiopas",
            "nullable": true,
            "type": "string",
          },
          "version": {
            "description": "Versionsnummer des Eintrags für Änderungshistorie",
            "example": 1,
            "minimum": 1,
            "type": "number",
          },
        },
        "required": [
          "id",
          "sequenceNumber",
          "kategorie",
          "text",
          "timestamp",
          "version",
          "isAutomatic",
          "createdBy",
          "createdAt",
          "isDeleted",
          "isKorrektur",
          "isKorrigiert",
          "ereignisZeitpunkt",
          "erfasstAm",
          "kontext",
        ],
        "type": "object",
      },
