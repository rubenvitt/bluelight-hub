      "get": {
        "description": "Paginierte Liste aller Einsätze. Archivierte standardmäßig ausgeschlossen. EXTERNE sehen nur zugewiesene Einsätze.",
        "operationId": "EinsatzController_findAll_v-1",
        "parameters": [
          {
            "description": "Filter nach Einsatz-Status",
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "enum": [
                "ANGELEGT",
                "IN_BEARBEITUNG",
                "ABGESCHLOSSEN",
                "ARCHIVIERT",
              ],
              "example": "ANGELEGT",
              "type": "string",
            },
          },
          {
            "description": "Vollstaendigkeits-Information einschliessen",
            "in": "query",
            "name": "includeCompleteness",
            "required": false,
            "schema": {
              "example": false,
              "type": "boolean",
            },
          },
          {
            "description": "Seitennummer fuer Pagination (startet bei 1)",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "example": 1,
              "minimum": 1,
              "type": "number",
            },
          },
          {
            "description": "Anzahl Eintraege pro Seite",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "example": 20,
              "maximum": 100,
              "minimum": 1,
              "type": "number",
            },
          },
          {
            "description": "Suchbegriff fuer Alarmstichwort oder ID (durchsucht auch den generierten Namen)",
            "in": "query",
            "name": "search",
            "required": false,
            "schema": {
              "example": "Wohnungsbrand",
              "type": "string",
            },
          },
          {
            "description": "Archivierte Einsaetze einschliessen (Standard: false - gemaess No-Delete Policy)",
            "in": "query",
            "name": "includeArchived",
            "required": false,
            "schema": {
              "default": false,
              "example": false,
              "type": "boolean",
            },
          },
          {
            "description": "Sortierfeld",
            "in": "query",
            "name": "orderBy",
            "required": false,
            "schema": {
              "enum": [
                "createdAt",
                "updatedAt",
                "alarmstichwort",
                "status",
                "name",
              ],
              "example": "createdAt",
              "type": "string",
            },
          },
          {
            "description": "Sortierrichtung",
            "in": "query",
            "name": "orderDirection",
            "required": false,
            "schema": {
              "enum": [
                "asc",
                "desc",
              ],
              "example": "desc",
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "items": {
