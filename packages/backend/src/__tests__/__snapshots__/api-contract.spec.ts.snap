                      },
                      "type": "array",
                    },
                    "meta": {
                      "properties": {
                        "requestId": {
                          "example": "abc123xyz",
                          "type": "string",
                        },
                        "timestamp": {
                          "example": "2025-08-29T14:00:00.000Z",
                          "format": "date-time",
                          "type": "string",
                        },
                        "version": {
                          "example": "alpha",
