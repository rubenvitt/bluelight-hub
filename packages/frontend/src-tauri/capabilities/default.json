{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": ["main", "etb-dashboard", "admin"],
  "webviews": ["etb-dashboard", "admin"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        }
      ]
    },
    {
      "identifier": "core:webview:default",
      "allow": ["create", "webview-show"]
    },
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "core:window:allow-create",
    "core:window:allow-close",
    "core:window:allow-maximize",
    "core:window:allow-minimize",
    "core:window:allow-set-size",
    "core:window:allow-center",
    "core:webview:allow-create-webview-window",
    "store:default",
    "store:allow-get",
    "store:allow-set",
    "store:allow-has",
    "store:allow-delete",
    "store:allow-clear",
    "store:allow-keys",
    "barcode-scanner:default",
    "deep-link:default",
    "notification:default",
    "notification:allow-notify",
    "notification:allow-show",
    "notification:allow-request-permission",
    "notification:allow-is-permission-granted",
    "notification:allow-check-permissions",
    "notification:allow-permission-state",
    "notification:allow-create-channel",
    "notification:allow-delete-channel",
    "notification:allow-list-channels",
    "notification:allow-register-action-types",
    "notification:allow-register-listener",
    "notification:allow-get-pending",
    "notification:allow-cancel",
    "notification:allow-get-active",
    "notification:allow-remove-active",
    "notification:allow-batch"
  ]
}
