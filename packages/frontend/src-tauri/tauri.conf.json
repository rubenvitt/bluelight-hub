{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "bluelight-hub",
  "version": "1.0.0-37",
  "identifier": "de.bluelight-hub.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:vite",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "https://localhost:3090",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "[DEV] Bluelight Hub",
        "width": 800,
        "height": 800,
        "minWidth": 600,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": ["../public/sounds"]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["bluelight"]
      }
    }
  }
}
