{
  "name": "@bluelight-hub/shared",
  "version": "1.0.0-alpha.46",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./client/index.ts",
      "import": "./client/index.ts"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "import": "./dist/schemas/index.js"
    }
  },
  "scripts": {
    "lint": "biome check --write",
    "lint:check": "biome check",
    "generate-api": "rimraf client && openapi-generator-cli generate -g=typescript-fetch -i https://localhost:3091/api-json -o ./client --skip-validate-spec && pnpm lint",
    "build:tsc": "tsc -p tsconfig.build.json",
    "build": "pnpm build:tsc",
    "build:with-api": "pnpm generate-api && pnpm build:tsc",
    "build:ci": "pnpm build",
    "test": "echo 'No tests available for shared package'"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.27.0",
    "rimraf": "^6.1.2",
    "typescript": "^5.9.3"
  }
}
