{
  "name": "@bluelight-hub/shared",
  "version": "1.0.0-alpha.104",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./client/index.ts",
      "import": "./client/index.ts"
    },
    "./client-v1": {
      "types": "./client-v1/index.ts",
      "import": "./client-v1/index.ts"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "import": "./dist/schemas/index.js"
    }
  },
  "scripts": {
    "lint": "oxlint --fix && oxfmt --write .",
    "lint:check": "oxlint && oxfmt --check .",
    "generate-api": "pnpm generate-api:alpha && pnpm lint",
    "generate-api:alpha": "node ./scripts/generate-openapi-client.mjs alpha",
    "generate-api:all": "pnpm generate-api:alpha && pnpm generate-api:v1 && pnpm lint",
    "generate-api:v1": "node ./scripts/generate-openapi-client.mjs v1",
    "build:tsc": "tsc -p tsconfig.build.json",
    "build": "pnpm build:tsc",
    "build:with-api": "pnpm generate-api && pnpm build:tsc",
    "build:ci": "pnpm build",
    "test": "echo 'No tests available for shared package'"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.31.1",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  }
}
